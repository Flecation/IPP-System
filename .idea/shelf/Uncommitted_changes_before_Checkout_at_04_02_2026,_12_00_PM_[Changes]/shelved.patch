<+>@import url(\"main.css\");\n\n.background{\n  -fx-background-image: url(\"/Photos/logInImage1.png\");\n  -fx-background-repeat: no-repeat;\n  -fx-background-size: cover;\n  -fx-background-position: center;\n  -fx-width: 100%;\n  -fx-height: 100%;\n\n}\n\n.header-text{\n    -fx-font-size: 25px;\n    -fx-font-family : \"Poppins\";\n    -fx-font-weight: bold;\n    -fx-text-fill: white;\n}\n\n.rightPane {\n    /* Semi-transparent white background */\n    -fx-background-color: rgba(255,255,255, 0.7) ;\n\n    /* Rounded corners to match the glass look */\n    -fx-background-radius: 70 0 0 70;\n    -fx-border-radius: 70 0 0 70;\n\n    /* A thin, subtle white border creates the \"edge\" of the glass */\n    -fx-border-color: rgba(255, 255, 255, 0.3);\n    -fx-border-width: 1px;\n\n    /* This adds the inner glow/blur effect */\n    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);\n\n}\n.rightBlur{\n        -fx-background-color: rgba(255,255,255, 0.35);\n\n        -fx-background-radius: 70 0 0 70;\n        -fx-border-radius: 70 0 0 70;\n\n        -fx-border-color: rgba(255, 255, 255, 0.4);\n        -fx-border-width: 1px;\n\n        /* REAL blur effect on this node */\n        -fx-effect: gaussian-blur(200);\n}\n\n.loginTitle {\n    -fx-font-size: 20px;\n    -fx-text-fill: -primary-text-color;\n    -fx-fill: -primary-text-color;\n}\n\n.loginLogoName {\n    -fx-font-size: 38px;\n    -fx-text-fill: -primary-text-color;\n    -fx-fill: -primary-text-color;\n}\n\n#userNameLbl , #passwordLbl {\n    -fx-text-fill: #011121;\n    -fx-background-color: transparent;\n    -fx-font-size: 15px;\n}\n\n#loginBtn:pressed {\n    -fx-background-color: #011121;\n    -fx-text-fill: white;\n}\n/* 1. The default state of the button */\n#loginBtn,#sentResetCodeBtn,#changePwBtn {\n    -fx-background-color: #FFA500; /* Standard Orange */\n    -fx-border-radius: 15px;\n    -fx-background-radius: 15px;\n    -fx-text-fill: white;\n    -fx-font-weight: bold;\n    -fx-font-family: \"Poppins\";\n    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0.3, 0, 4);\n}\n\n\n/* 3. When you CLICK/SELECT the button (Brighter Orange) */\n#loginBtn:pressed {\n    /* Using derive(color, percentage) makes it 30% brighter than the original */\n    -fx-background-color: #f57f18;\n    -fx-text-fill: white;\n}\n#forgetBtn {\n      -fx-underline: true;\n      -fx-font-size: 10px;\n      -fx-text-fill: #011121;\n      -fx-font-weight: bold;\n      -fx-font-family: \"Poppins\";\n      -fx-cursor: hand;\n      -fx-background-color: transparent;\n}\n.info-text{\n  -fx-text-fill: #011121;\n  -fx-font-size :15px;\n}\n\n/* Target the text color and the cursor for all input fields */\n.text-field, .password-field, .text-field > .text, .password-field > .text {\n    -fx-text-fill: white !important;\n    -fx-fill: white !important; /* For the internal Text node */\n    -fx-caret-fill: white;      /* Makes the blinking cursor white */\n}\n\n.check-box .box {\n    -fx-background-color: transparent !important;\n    -fx-border-color: grey !important; /* Forces the border to be black */\n    -fx-border-width: 2px;\n    -fx-border-radius: 2px;\n    -fx-background-radius: 2px;\n}\n\n/* This makes the 'check' mark black to match */\n.check-box:selected .mark {\n    -fx-background-color: black !important;\n    -fx-mark-color: black !important;\n}\n\n/* 1. Apply the UPWARDS movement and font size to BOTH checkboxes */\n#showPasswordCheckBox,\n#showChangePwChoiceBox {\n    -fx-translate-y: -4px;\n    -fx-font-size: 10px;\n}\n\n/* 2. FORCE the text to be GREY and add the downward padding */\n#showPasswordCheckBox .label,\n#showChangePwChoiceBox .label {\n    -fx-text-fill: #808080 !important; /* Grey color */\n    -fx-padding: 10px 0 0 5px;         /* Moves text down 10px relative to box */\n}\n\n/* 3. Make the square SMALL and HOLLOW for both */\n#showPasswordCheckBox .box,\n#showChangePwChoiceBox .box {\n    -fx-padding: 0;\n    -fx-min-width: 13px;\n    -fx-max-width: 13px;\n    -fx-min-height: 13px;\n    -fx-max-height: 13px;\n    -fx-background-color: transparent !important;\n    -fx-border-color: black !important;\n    -fx-border-width: 1.5px;\n    -fx-background-radius: 2px;\n    -fx-border-radius: 2px;\n}\n\n/* 4. Handle the CHECKED state (White box, Black mark) */\n#showPasswordCheckBox:selected .box,\n#showChangePwChoiceBox:selected .box {\n    -fx-background-color: white !important;\n}\n\n#showPasswordCheckBox:selected .mark,\n#showChangePwChoiceBox:selected .mark {\n    -fx-background-color: black !important;\n    -fx-scale-x: 0.6;\n    -fx-scale-y: 0.6;\n}\n/* 1. Sets the color of the text to black while typing */\n.text-field:focused,\n.password-field:focused,\n#userNameTxt:focused,\n#hidePasswordTxt:focused {\n    -fx-text-fill: black !important;\n}\n\n/* 2. Sets the blinking cursor (caret) to black so it is visible */\n.text-field, .password-field {\n    -fx-caret-fill: black;\n}\n\n/* 3. Ensure the text stays black even if there is an internal 'text' node conflict */\n.text-field:focused .text,\n.password-field:focused .text {\n    -fx-fill: black !important;\n}\n\n#forgetBtn{\n    -fx-font-weight: regular;\n}\n.label .backTo{\n    -fx-text-fill: grey;\n}\n#backToLogin {\n    -fx-text-fill: black !important;   /* Sets the color to grey */\n    -fx-underline: true;               /* Adds the underline */\n    -fx-background-color: transparent; /* Makes the button background invisible */\n    -fx-cursor: hand;                  /* Changes cursor to a hand on hover */\n    -fx-font-family: \"Poppins\";        /* Matches your other text */\n    -fx-font-size: 12px;\n}\n\n.backTo {\n    -fx-text-fill: grey !important;\n    -fx-font-family: \"Poppins\";\n    -fx-font-size: 12px;\n}
