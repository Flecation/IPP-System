ackground-color: #C01111;\n    -fx-text-fill: #dedede;\n\n    -fx-opacity:0.8;\n\n\n    -fx-background-radius: 5;\n    -fx-padding:5 10 5 10;\n}\n\n\n.managerAccSpBtnDel:hover{\n    -fx-background-color: #C01111;\n    -fx-text-fill: #dedede;\n    -fx-text-fill: #EFBF04;\n\n\n}\n\n/* Personal Information  */\n.managerAccSpSubLabel{\n    -fx-font-size: -title-font-size;\n}\n\n\n\n /* :: Add Btn */\n.addSupervisorBtn{\n   -fx-background-color:#558C8A;\n   -fx-padding: 3 10 3 10;\n}\n\n.subTitle{\n    -fx-font-size: 16;\n}\n\n\n\n/* Other Engineer List */\n.active-engineer {\n    -fx-background-color:#D9D9D9;\n    -fx-background-radius: 8;\n    -fx-padding: 8 12 8 12; /* TOP RIGHT BOTTOM LEFT */\n}\n\n/* Hover effect */\n.active-engineer:hover,.other-engineer:hover{\n       -fx-background-color:#D9D9D9;\n    -fx-opacity: 0.7;\n}\n\n.active-engineer .label {\n    -fx-text-fill: #558C8A;\n    -fx-font-weight: bold;\n}\n\n.active{\n    -fx-border-width: 0.5;\n    -fx-border-color: #558C8A;\n    -fx-border-radius: 100;\n}\n\n.inactive{\n    -fx-border-width: 0.5;\n    -fx-border-color: #C01111;\n    -fx-border-radius: 100;\n\n}\n\n.resign{\n    -fx-background-color: #C01111;\n    -fx-opacity: 0.7;\n    -fx-padding:5 10;\n    -fx-background-radius:20;\n    -fx-text-fill:#ffffff;\n}\n\n.resign:hover{\n    -fx-background-color: #C01111;\n   -fx-opacity: 0.5;\n}\n\n.resign-color{\n    -fx-text-fill: #a1220e;\n}\n\n\n\n\n/* Match the main container to the ComboBox height and border */\n.date-picker {\n    -fx-background-color: #b0b0b0, linear-gradient(to bottom, #f2f2f2, #dcdcdc);\n    -fx-background-insets: 0, 1;\n    -fx-background-radius: 5;\n    -fx-padding: 0;\n    -fx-alignment: CENTER_LEFT;\n}\n\n/* Style the text area inside the DatePicker */\n.date-picker > .text-field {\n    -fx-background-color: transparent;\n    -fx-text-fill: #333333;\n    -fx-font-weight: bold; /* Matches your \"Skill/Status\" bold text */\n    -fx-font-size: 13px;\n    -fx-padding: 5 10 5 10;\n}\n