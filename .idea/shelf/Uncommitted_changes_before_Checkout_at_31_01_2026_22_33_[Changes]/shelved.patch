+    // Progress calculation methods - ORIGINAL VERSION
+    public long getTotalDuration() {
+        // Simple test data for day remaining calculation
+        if (assignProjectId == 1) return 240; // Golden Tower - 240 days total
+        if (assignProjectId == 2) return 180; // Skyline Office - 180 days total
+        if (assignProjectId == 3) return 360; // Maha Bridge - 360 days total
+        if (assignProjectId == 4) return 120; // Yangon Factory - 120 days total
+        if (assignProjectId == 5) return 300; // Al-Amin Mosque - 300 days total
+        return 365; // Default
+    }
+
+    public long getRemainingDays() {
+        // Simple test data for remaining days
+        if (assignProjectId == 1) return 120; // Golden Tower - 120 days remaining
+        if (assignProjectId == 2) return 36;  // Skyline Office - 36 days remaining
+        if (assignProjectId == 3) return 288; // Maha Bridge - 288 days remaining
+        if (assignProjectId == 4) return 48;  // Yangon Factory - 48 days remaining
+        if (assignProjectId == 5) return 180; // Al-Amin Mosque - 180 days remaining
+        return 0;
+    }
+
+    public long getElapsedDays() {
+        if (startDate == null) return 0;
+        long diffInMillies = System.currentTimeMillis() - startDate.getTime();
+        return Math.max(0, diffInMillies / (1000 * 60 * 60 * 24));
+    }
+
+    public int getTotalTasks() {
+        // Simple test data for completed task calculation
+        if (assignProjectId == 1) return 5; // Golden Tower - 5 total tasks
+        if (assignProjectId == 2) return 5; // Skyline Office - 5 total tasks
+        if (assignProjectId == 3) return 5; // Maha Bridge - 5 total tasks
+        if (assignProjectId == 4) return 5; // Yangon Factory - 5 total tasks
+        if (assignProjectId == 5) return 5; // Al-Amin Mosque - 5 total tasks
+        return 10; // Default
+    }
+
+    public int getDoneTasks() {
+        // Simple test data for completed task calculation
+        if (assignProjectId == 1) return 2; // Golden Tower - 2 completed (40%)
+        if (assignProjectId == 2) return 4; // Skyline Office - 4 completed (80%)
+        if (assignProjectId == 3) return 1; // Maha Bridge - 1 completed (20%)
+        if (assignProjectId == 4) return 3; // Yangon Factory - 3 completed (60%)
+        if (assignProjectId == 5) return 2; // Al-Amin Mosque - 2 completed (40%)
+        return 2; // Default
+    }
+
+    public double getPlannedValue() {
+        return projectCost; // Total cost is planned value
+    }
+
+    public double getEarnedValue() {
+        // Simple test data for earned value calculation
+        int totalTasks = getTotalTasks();
+        int doneTasks = getDoneTasks();
+
+        if (totalTasks > 0) {
+            double completionRatio = (double) doneTasks / totalTasks;
+
+            // Different earned value patterns for testing
+            switch (assignProjectId) {
+                case 1: // Golden Tower - Normal earned value
+                    return projectCost * completionRatio; // 40% of 180M = 72M
+                case 2: // Skyline Office - High earned value
+                    return projectCost * (completionRatio * 1.2); // 80% of 120M = 115.2M
+                case 3: // Maha Bridge - Low earned value
+                    return projectCost * (completionRatio * 0.8); // 20% of 80M = 12.8M
+                case 4: // Yangon Factory - Standard earned value
+                    return projectCost * completionRatio; // 60% of 60M = 36M
+                case 5: // Al-Amin Mosque - High earned value
+                    return projectCost * (completionRatio * 1.5); // 40% of 40M = 24M
+                default:
+                    return projectCost * completionRatio;
+            }
+        }
+        return 0;
+    }
 }
