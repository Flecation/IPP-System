                                 <items>
                                    <FXCollections fx:factory="observableArrayList">
                                       <String fx:value="All Reports" />
                                       <String fx:value="Daily Site Log" />
                                       <String fx:value="Safety Incident" />
                                       <String fx:value="Material Request" />
                                    </FXCollections>
                                 </items>
                              </ComboBox>
                           </children>
                        </VBox>
                        <Button style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-pref-width: 80;" text="Filter">
