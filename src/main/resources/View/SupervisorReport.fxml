                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" minWidth="150.0" prefWidth="200.0" spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 15px;" text="Central Tower" />
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="By: Mg Mg (Supervisor)" />
                           </children>
                        </VBox>
                        <Label alignment="CENTER" minWidth="100.0" style="-fx-background-color: #e8f6f3; -fx-text-fill: #1abc9c; -fx-background-radius: 15; -fx-padding: 5 10; -fx-font-size: 12px; -fx-font-weight: bold;" text="Daily Site Log" />
                        <HBox alignment="CENTER_LEFT" minWidth="100.0" spacing="5.0">
                           <children>
                              <Circle fill="#e74c3c" radius="4.0" />
                              <Label style="-fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-font-weight: bold;" text="1 Issue" />
                           </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                           <children>
                              <VBox alignment="CENTER_RIGHT">
                                 <children>
                                    <Label style="-fx-text-fill: #bdc3c7; -fx-font-size: 10px;" text="Review" />
                                 </children>
                              </VBox>
                              <Button prefHeight="34.0" prefWidth="120.0" style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-text-fill: #7f8c8d; -fx-cursor: hand;" text="View Details ➔" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="850.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1); -fx-cursor: hand;">
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <children>
                        <VBox alignment="CENTER_LEFT" minWidth="100.0" prefWidth="120.0" spacing="5.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14px;" text="#RPT-003" />
                              <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 12px;" text="Jan 15, 2024" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" minWidth="150.0" prefWidth="200.0" spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 15px;" text="Central Tower" />
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="By: Mg Mg (Supervisor)" />
                           </children>
                        </VBox>
                        <Label alignment="CENTER" minWidth="100.0" style="-fx-background-color: #e8f6f3; -fx-text-fill: #1abc9c; -fx-background-radius: 15; -fx-padding: 5 10; -fx-font-size: 12px; -fx-font-weight: bold;" text="Daily Site Log" />
                        <HBox alignment="CENTER_LEFT" minWidth="100.0" spacing="5.0">
                           <children>
                              <Circle fill="#e74c3c" radius="4.0" />
                              <Label style="-fx-text-fill: #c0392b; -fx-font-size: 12px; -fx-font-weight: bold;" text="1 Issue" />
                           </children>
