                        <VBox prefWidth="300.0" style="-fx-background-color: #fff5f5; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #ffcccc;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #c0392b; -fx-font-size: 14px;" text="⚠️ Issues &amp; Risks Reported" />
                                <Separator style="-fx-padding: 10 0;" />
                                <TextArea fx:id="issuesTextArea" editable="true" maxWidth="1.7976931348623157E308" prefRowCount="4" style="-fx-control-inner-background: #fff5f5; -fx-background-color: transparent;" promptText="Report any issues or risks..." wrapText="true" />
                            </children>
                        </VBox>
                        <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14px;" text="📝 General Comments" />
                                <Separator style="-fx-padding: 10 0;" />
                                <TextArea fx:id="commentsTextArea" editable="true" maxWidth="1.7976931348623157E308" prefRowCount="4" style="-fx-background-color: transparent;" promptText="Add general comments..." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button fx:id="submitReportBtn" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25;" text="Submit Report" />
                    </children>
                </HBox>
            </children>

        </VBox>
    </content>
</ScrollPane>