<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<ScrollPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.SupervisorReportController">
    <content>
        <VBox spacing="15">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Create Daily Site Report" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Separator prefWidth="200.0" />
                    </children>
                </VBox>
                <TitledPane expanded="true" maxHeight="109.6" maxWidth="644.8" minWidth="644.8" text="Project Information">
                    <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                            <children>
                                <VBox prefHeight="200.0" prefWidth="100.0">
                                    <children>
                                        <HBox prefHeight="100.0" prefWidth="200.0">
                                            <children>
                                                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <HBox prefHeight="64.0" prefWidth="257.0" spacing="10.0">
                                                            <children>
                                                                <Label text="Project Name" />
                                                                <TextField fx:id="projectNameField" promptText="Type project name..." />
                                                            </children>
                                                        </HBox>
                                                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="7.0">
                                                            <children>
                                                                <Label text="Assigned Task" />
                                                                <ComboBox fx:id="assignedTaskComboBox" prefWidth="150.0" promptText="Select Task" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <HBox spacing="10.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label prefHeight="18.0" prefWidth="90.0" text="Report Date">
                                                            <HBox.margin>
                                                                <Insets left="40.0" />
                                                            </HBox.margin>
                                                        </Label>
                                                        <DatePicker fx:id="reportDatePicker" maxWidth="149.6" minWidth="149.6" prefHeight="26.0">
                                                            <HBox.margin>
                                                                <Insets left="20.0" />
                                                            </HBox.margin>
                                                        </DatePicker>
                                                    </children>
                                                    <HBox.margin>
                                                        <Insets />
                                                    </HBox.margin>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                    <VBox.margin>
                                        <Insets left="50.0" right="50.0" top="10.0" />
                                    </VBox.margin>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <TitledPane maxHeight="179.2" maxWidth="644.8" minWidth="644.8" text="Weather Condition">
                    <content>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                            <children>
                                <VBox>
                                    <children>
                                        <HBox prefHeight="53.0" prefWidth="549.0">
                                            <children>
                                                <HBox prefHeight="100.0" prefWidth="190.0" spacing="10.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Weather Type" />
                                                        <ComboBox fx:id="weatherTypeComboBox" minWidth="149.6" prefHeight="26.0" promptText="Select weather" />
                                                    </children>
                                                </HBox>
                                                <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label prefHeight="18.0" prefWidth="100.0" text="Work Affected">
                                                            <HBox.margin>
                                                                <Insets left="21.0" />
                                                            </HBox.margin>
                                                        </Label>
                                                        <ComboBox fx:id="workAffectedComboBox" minWidth="149.6" prefHeight="26.0" promptText="Select effect">
                                                            <HBox.margin>
                                                                <Insets left="10.0" />
