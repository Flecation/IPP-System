                                                    <children>
                                                        <VBox alignment="CENTER_LEFT" spacing="20.0">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT">
                                                                    <children>
                                                                        <Label text="Working Hours" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT">
                                                                    <children>
                                                                        <Label text="Remark" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <TextField fx:id="workingHourField" promptText="Enter hours" />
                                                                <TextArea fx:id="laborRemarkTextArea" promptText="Labor remark (optional)"
                                                                          prefRowCount="2" wrapText="true" />
