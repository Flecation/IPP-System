                        <VBox spacing="5">
                           <children>
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="From Date" />
                              <DatePicker fx:id="startDatePicker" promptText="Start Date" style="-fx-pref-width: 140;" />
                           </children>
                        </VBox>
                        <Label style="-fx-padding: 25 0 0 0; -fx-text-fill: #bdc3c7; -fx-font-size: 18px;" text="-" />
                        <VBox spacing="5">
                           <children>
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="To Date" />
                              <DatePicker fx:id="endDatePicker" promptText="End Date" style="-fx-pref-width: 140;" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox spacing="5">
                           <children>
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="Report Type" />
