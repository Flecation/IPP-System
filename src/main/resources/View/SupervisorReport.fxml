                                                        </ComboBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                                            <children>
                                                <Label prefHeight="18.0" prefWidth="84.0" text="Weather Notes" />
                                                <TextArea fx:id="weatherNotesTextArea" prefHeight="91.0" prefWidth="440.0" promptText="Additional weather observations..." />
                                            </children>
                                        </HBox>
                                    </children>
                                    <VBox.margin>
                                        <Insets left="50.0" right="50.0" top="10.0" />
                                    </VBox.margin>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <TitledPane expanded="true" maxWidth="644.8" minWidth="644.8" text="Labor Information">
