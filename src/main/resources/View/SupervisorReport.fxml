                        <VBox prefHeight="82.0" prefWidth="643.0" spacing="10">
                            <padding>
                                <Insets bottom="10" left="10" right="10" top="10" />
                            </padding>
                            <children>
                                <VBox>
                                    <children>
                                        <HBox prefHeight="317.0" prefWidth="622.0" spacing="10.0">
                                            <children>
                                                <Label text="Material Cost ($)" />
