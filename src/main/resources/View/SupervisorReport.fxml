                                            </children>
                                        </HBox>
                                        <Label prefHeight="18.0" prefWidth="494.0" style="-fx-text-fill: #999; -fx-font-style: italic; -fx-alignment: center;" text="Real Time Real Place Give us Money!" />
                                    </children>
                                    <VBox.margin>
                                        <Insets left="50.0" right="50.0" top="10.0" />
                                    </VBox.margin>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
