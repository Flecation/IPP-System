                                                                        <FXCollections fx:factory="observableArrayList">
                                                                            <String fx:value="In Progress" />
                                                                            <String fx:value="Completed" />
                                                                            <String fx:value="Delayed" />
                                                                        </FXCollections>
                                                                    </items>
                                                                </ComboBox>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="5">
                                                            <children>
                                                                <Label text="Risk Level:">
                                                                    <VBox.margin>
                                                                        <Insets bottom="10.0" />
                                                                    </VBox.margin>
                                                                </Label>
                                                                <ComboBox fx:id="riskLevelComboBox" promptText="Select risk level">
                                                                    <items>
                                                                        <FXCollections fx:factory="observableArrayList">
                                                                            <String fx:value="Low" />
                                                                            <String fx:value="Medium" />
                                                                            <String fx:value="High" />
                                                                            <String fx:value="Critical" />
                                                                        </FXCollections>
                                                                    </items>
                                                                </ComboBox>
                                                            </children>
                                                        </VBox>
                                                        <HBox spacing="15.0">
