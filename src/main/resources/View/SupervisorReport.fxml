                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT">
                                                                    <children>
                                                                        <Label text="Daily Wage" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="CENTER_LEFT" maxWidth="453.6" spacing="10.0">
                                                            <children>
                                                                <ComboBox fx:id="laborComboBox" maxWidth="453.6" promptText="Select labor" />
                                                                <TextField fx:id="dailyWageField" maxWidth="453.6" promptText="Enter daily wage" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
