<BorderPane fx:id="mainBorderPane" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.SupervisorReportController">
   <left>
      <VBox fx:id="sidebar" maxWidth="320.0" minWidth="320.0" prefWidth="320.0" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 0 1 0 0;">
         <children>
            <VBox spacing="5" style="-fx-padding: 20 20 10 20;">
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="My Projects" />
                  <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="Select a project to view its history" />
                  <VBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-radius: 8; -fx-border-color: #e9ecef; -fx-margin: 10 0 0 0;">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Filter:" />
                              <ComboBox fx:id="projectSidebarFilter" maxWidth="Infinity" promptText="Status: Ongoing" HBox.hgrow="ALWAYS">
                                 <items>
                                    <FXCollections fx:factory="observableArrayList">
                                       <String fx:value="All Assigned" />
                                       <String fx:value="Ongoing" />
                                       <String fx:value="Finished" />
                                    </FXCollections>
                                 </items>
                              </ComboBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <Separator />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: white;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <VBox spacing="15" style="-fx-padding: 15;">
                     <children>
                        <VBox style="-fx-background-color: white; -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <children>
                                    <VBox>
                                       <children>
                                          <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Central Tower" />
                                          <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Commercial - 65% Complete" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-border-color: #f39c12; -fx-border-width: 0 0 0 5; -fx-padding: 15; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10">
                                 <children>
                                    <VBox>
                                       <children>
                                          <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Green Valley" />
                                          <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Residential - 45% Complete" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </left>
   <center>
      <BorderPane style="-fx-padding: 25; -fx-background-color: #ededed;">
         <top>
            <VBox spacing="20" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox>
                           <children>
                              <Label style="-fx-font-family: 'Arial Black'; -fx-font-weight: bold; -fx-font-size: 28px;" text="Reports" />
