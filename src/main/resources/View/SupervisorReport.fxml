                                                                        <FXCollections fx:factory="observableArrayList">
                                                                            <String fx:value="Planning" />
                                                                            <String fx:value="Foundation" />
                                                                            <String fx:value="Superstructure" />
                                                                            <String fx:value="Finishing" />
                                                                            <String fx:value="MEP Installation" />
                                                                            <String fx:value="External Works" />
                                                                            <String fx:value="Final Inspection" />
                                                                        </FXCollections>
                                                                    </items>
                                                                </ComboBox>
                                                            </children>
                                                        </VBox>
                                                        <VBox>
                                                            <children>
                                                                <HBox>
