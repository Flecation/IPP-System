                                                <TableColumn fx:id="colLaborName" prefWidth="139.19997346401215" text="Labor Name" />
                                                <TableColumn fx:id="colSkill" prefWidth="114.40005493164062" text="Skill" />
                                                <TableColumn fx:id="colWage" prefWidth="124.0" text="Daily Wage" />
                                                <TableColumn fx:id="colHours" prefWidth="114.40005493164062" text="Hours" />
                                                <TableColumn fx:id="colRemarks" prefWidth="127.19998168945312" text="Remarks" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                            <VBox.margin>
                                                <Insets right="56.0" />
                                            </VBox.margin>
                                        </TableView>
                                    </children>
                                    <VBox.margin>
                                        <Insets left="50.0" top="10.0" />
                                    </VBox.margin>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </TitledPane>
                <TitledPane maxWidth="644.8" minWidth="644.8" text="Material Tracking">
