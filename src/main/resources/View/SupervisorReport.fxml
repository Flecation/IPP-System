                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <Pagination fx:id="reportPagination" maxPageIndicatorCount="5" style="-fx-page-information-visible: false;">
               <BorderPane.margin>
                  <Insets top="20.0" />
               </BorderPane.margin>
            </Pagination>
         </center>
      </BorderPane>
   </center>
</BorderPane>
