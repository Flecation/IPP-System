<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" maxWidth="686.4" minWidth="686.4" style="-fx-background: #f8fafc;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.ViewReportController">
    <content>
        <VBox maxWidth="686" minWidth="686" spacing="20" style="-fx-padding: 25;">

            <!-- Header Section -->
            <VBox spacing="8" style="-fx-padding: 0 0 15 0;">
                <Label style="-fx-font-weight: 700; -fx-font-size: 28px; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI Semibold';" text="Daily Site Report">
                    <font>
                        <Font name="Segoe UI Semibold" size="28.0" />
                    </font>
                </Label>
                <Label fx:id="reportDateHeader" style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-family: 'Segoe UI'; -fx-font-weight: 400;" />
                <Separator style="-fx-background-color: linear-gradient(to right, transparent 0%, #3b82f6 20%, #3b82f6 80%, transparent 100%); -fx-pref-height: 2; -fx-padding: 8 0 0 0;" />
            </VBox>

            <!-- Project Information -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0.2, 0, 2);">
                <Label style="-fx-font-weight: 600; -fx-font-size: 17px; -fx-text-fill: #1e293b; -fx-padding: 0 0 18 0; -fx-font-family: 'Segoe UI';" text="📋 Project Information" />

                <GridPane hgap="30" style="-fx-padding: 5 0 0 0;" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Row 1: Two items -->
                    <VBox spacing="6" GridPane.columnIndex="0">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Project Name" />
                        <Label fx:id="projectNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #0f172a; -fx-wrap-text: true; -fx-padding: 5 0; -fx-font-weight: 500; -fx-font-family: 'Segoe UI';" text="Loading..." />
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Assigned Task" />
                        <Label fx:id="assignedTaskLabel" style="-fx-font-size: 15px; -fx-text-fill: #0f172a; -fx-wrap-text: true; -fx-padding: 5 0; -fx-font-weight: 500; -fx-font-family: 'Segoe UI';" text="Loading..." />
                    </VBox>

                    <!-- Row 2: One item spanning full width -->
                    <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Report Date" />
                        <Label fx:id="reportDateLabel" style="-fx-font-size: 15px; -fx-text-fill: #0f172a; -fx-padding: 5 0; -fx-font-weight: 500; -fx-font-family: 'Segoe UI';" text="Loading..." />
                    </VBox>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Weather Conditions -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0.2, 0, 2);">
                <Label style="-fx-font-weight: 600; -fx-font-size: 17px; -fx-text-fill: #1e293b; -fx-padding: 0 0 18 0; -fx-font-family: 'Segoe UI';" text="🌤️ Weather Conditions" />

                <GridPane hgap="30" style="-fx-padding: 5 0 0 0;" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Row 1: Weather Type -->
                    <VBox spacing="6" GridPane.columnIndex="0">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Weather Type" />
                        <Label fx:id="weatherTypeLabel" style="-fx-font-size: 15px; -fx-text-fill: #0f172a; -fx-padding: 5 0; -fx-font-weight: 500; -fx-font-family: 'Segoe UI';" text="Loading..." />
                    </VBox>

                    <!-- Row 2: Weather Notes (CHANGED from TextArea to Label) -->
                    <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Weather Notes" />
                        <Label fx:id="weatherNotesLabel" style="-fx-font-size: 15px; -fx-text-fill: #334155; -fx-wrap-text: true; -fx-padding: 10 14; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-font-family: 'Segoe UI'; -fx-line-spacing: 1.4;" wrapText="true" text="Loading weather notes..." />
                    </VBox>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Labor Information -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0.2, 0, 2);">
                <Label style="-fx-font-weight: 600; -fx-font-size: 17px; -fx-text-fill: #1e293b; -fx-padding: 0 0 18 0; -fx-font-family: 'Segoe UI';" text="👷 Labor Information" />

                <TableView fx:id="laborTable" prefHeight="180" style="-fx-background-color: transparent; -fx-padding: 5 0 0 0;">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" style="-fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Labor Name" />
                        <TableColumn fx:id="colSkill" style="-fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Skill" />
                        <TableColumn fx:id="colWage" style="-fx-font-weight: 600; -fx-alignment: CENTER_RIGHT; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Daily Wage" />
                        <TableColumn fx:id="colHours" style="-fx-font-weight: 600; -fx-alignment: CENTER_RIGHT; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Hours" />
                        <TableColumn fx:id="colRemarks" style="-fx-font-weight: 600; -fx-alignment: CENTER_LEFT; -fx-text-fill: #475569; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" text="Status" />
                    </columns>
                    <style>
                        -fx-table-cell-border-color: #e2e8f0;
                        -fx-table-header-border-color: transparent;
                        -fx-font-family: 'Segoe UI';
                        -fx-font-size: 14px;
                    </style>
                </TableView>

                <!-- Labor Remarks (CHANGED from TextArea to Label) -->
                <VBox spacing="6" style="-fx-padding: 15 0 0 0;">
                    <children>
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Labor Remarks" />
                        <Label fx:id="laborRemarksLabel" style="-fx-font-size: 15px; -fx-text-fill: #334155; -fx-wrap-text: true; -fx-padding: 10 14; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-font-family: 'Segoe UI'; -fx-line-spacing: 1.4;" wrapText="true" text="Select a labor from the table above to view remarks" />
                    </children>
                </VBox>
            </VBox>

            <!-- Material Tracking -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0.2, 0, 2);">
                <Label style="-fx-font-weight: 600; -fx-font-size: 17px; -fx-text-fill: #1e293b; -fx-padding: 0 0 18 0; -fx-font-family: 'Segoe UI';" text="📦 Material Tracking" />

                <GridPane hgap="30" style="-fx-padding: 5 0 0 0;" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Single item centered in the row -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.halignment="CENTER">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-alignment: CENTER; -fx-font-family: 'Segoe UI';" text="Material Cost" />
                        <Label fx:id="materialCostLabel" style="-fx-font-size: 28px; -fx-text-fill: #059669; -fx-font-weight: 700; -fx-alignment: CENTER; -fx-padding: 5 0; -fx-font-family: 'Segoe UI'; -fx-effect: dropshadow(gaussian, rgba(5,150,105,0.15), 0, 0, 0, 1);" text="0" />
                    </VBox>
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <Label style="-fx-text-fill: #94a3b8; -fx-font-style: italic; -fx-font-size: 12px; -fx-padding: 12 0 0 0; -fx-alignment: center; -fx-font-family: 'Segoe UI';" text="Real Time Real Place Give us Money!" />
            </VBox>

            <!-- Project Progress -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0.2, 0, 2);">
                <Label style="-fx-font-weight: 600; -fx-font-size: 17px; -fx-text-fill: #1e293b; -fx-padding: 0 0 18 0; -fx-font-family: 'Segoe UI';" text="📊 Project Progress" />

                <GridPane hgap="30" style="-fx-padding: 5 0 0 0;" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Row 1: Remain Quantity and Completed Quantity -->
                    <VBox spacing="6" GridPane.columnIndex="0">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Remain Quantity" />
                        <Label fx:id="remainQuantityLabel" style="-fx-font-size: 15px; -fx-text-fill: #0f172a; -fx-padding: 5 0; -fx-font-weight: 500; -fx-font-family: 'Segoe UI';" text="0 units" />
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 2 0;" text="Completed Quantity" />
                        <Label fx:id="completedQuantityLabel" style="-fx-font-size: 15px; -fx-text-fill: #0f172a; -fx-padding: 5 0; -fx-font-weight: 500; -fx-font-family: 'Segoe UI';" text="0 units" />
                    </VBox>

                    <!-- Row 2: Progress Description (full width) -->
                    <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'; -fx-padding: 0 0 10 0;" text="Progress Description" />

                        <!-- Dynamic progress entries container -->
                        <VBox fx:id="progressContainer" spacing="10" style="-fx-padding: 10 0 0 0;">
                            <!-- Dynamic labels will be added here by controller -->
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #94a3b8; -fx-font-style: italic;" text="No progress description available" />
                        </VBox>
                    </VBox>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Issues Card -->
            <VBox style="-fx-background-color: #fef2f2; -fx-background-radius: 10; -fx-padding: 22; -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.05), 6, 0.2, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 18px;" text="⚠️" />
                    <Label style="-fx-font-weight: 600; -fx-font-size: 16px; -fx-text-fill: #b91c1c; -fx-font-family: 'Segoe UI';" text="Issues &amp; Risks" />
                </HBox>
                <Separator style="-fx-background-color: #fecaca; -fx-padding: 10 0;" />

                <!-- CHANGED from TextArea to Label -->
                <Label fx:id="issuesLabel" style="-fx-font-size: 14px; -fx-text-fill: #374151; -fx-wrap-text: true; -fx-padding: 10 0 0 0; -fx-line-spacing: 1.4; -fx-font-family: 'Segoe UI';" wrapText="true" text="No issues reported for this day." />
            </VBox>

            <!-- Comments Card -->
            <VBox style="-fx-background-color: #eff6ff; -fx-background-radius: 10; -fx-padding: 22; -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(29,78,216,0.05), 6, 0.2, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 18px;" text="💬" />
                    <Label style="-fx-font-weight: 600; -fx-font-size: 16px; -fx-text-fill: #1d4ed8; -fx-font-family: 'Segoe UI';" text="General Comments" />
                </HBox>
                <Separator style="-fx-background-color: #bfdbfe; -fx-padding: 10 0;" />

                <!-- CHANGED from TextArea to Label -->
                <Label fx:id="commentsLabel" style="-fx-font-size: 14px; -fx-text-fill: #374151; -fx-wrap-text: true; -fx-padding: 10 0 0 0; -fx-line-spacing: 1.4; -fx-font-family: 'Segoe UI';" wrapText="true" text="No general comments for this report." />
            </VBox>

        </VBox>
    </content>
</ScrollPane>