<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="675.0" prefWidth="1120.0" stylesheets="@../CSS/createrReport.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.allReportController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="280.0" prefWidth="280.0" style="-fx-background-color: #ffffff;" HBox.hgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER" maxWidth="280.0" minHeight="150.0" prefHeight="139.0" prefWidth="200.0" spacing="12.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" prefHeight="40.0" prefWidth="300.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label prefHeight="30.0" prefWidth="97.0" text="All Projects">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER">
                     <children>
                        <Label text="select a project to see reports" textFill="#000000a3">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <VBox alignment="CENTER" prefHeight="34.0" prefWidth="300.0">
                     <children>
                        <ComboBox fx:id="filterByProjectStatus" prefHeight="28.0" prefWidth="224.0" promptText="Filter By Status" styleClass="filter-box">
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                        </ComboBox>
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </VBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="1000.0" prefHeight="919.0" prefWidth="280.0" style="-fx-border-color: none; -fx-background-color: none;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox prefHeight="525.0" prefWidth="264.0">
                     <children>
                        <VBox fx:id="reportProjectScrollPane" cacheShape="false" centerShape="false" fillWidth="false" prefHeight="480.0" prefWidth="264.0" scaleShape="false" spacing="10.0" style="-fx-border-color: none;">
                           <padding>
                              <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
                           </padding>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
      <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER" maxHeight="80.0" minHeight="100.0" prefWidth="820.0" spacing="10.0" style="-fx-background-color: #f2f2f2f2;" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER_LEFT" prefHeight="61.0" prefWidth="335.0" spacing="6.0">
                     <children>
                        <Label prefHeight="30.0" prefWidth="203.0" styleClass="sub-title" text="Daily Reports" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="25.0" />
                           </font>
                        </Label>
                        <HBox>
                           <children>
                              <Label fx:id="countrepotsandissues" prefHeight="17.0" prefWidth="183.0" text="Showing 9 reports - 3 with issues">
                                 <font>
                                    <Font size="10.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="filterBySupervisor" prefHeight="28.0" prefWidth="236.0" promptText="Supervisor" styleClass="filter-box" />
                  <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="addNewReport" mnemonicParsing="false" onAction="#clickAddNewReport" prefHeight="27.0" prefWidth="240.0" styleClass="account-create-btn" stylesheets="@../CSS/managerSupervisorList.css" text="New Report" />
                     </children>
                  </VBox>
                  <Region prefHeight="82.0" prefWidth="37.0" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <DatePicker fx:id="startDate" maxHeight="30.0" prefHeight="30.0" prefWidth="149.0" promptText="Start Date" styleClass="date-picker" stylesheets="@../CSS/createrReport.css" HBox.hgrow="ALWAYS" />
                        <Region />
                        <DatePicker fx:id="endDate" editable="true" maxHeight="20.0" prefHeight="20.0" prefWidth="150.0" promptText="End Date" styleClass="date-picker" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: none;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="reportCardContainer" alignment="TOP_CENTER" prefHeight="553.0" prefWidth="823.0" spacing="12.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets bottom="20.0" />
         </padding>
      </VBox>
   </children>
</HBox>
