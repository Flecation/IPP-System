<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="IPPSystem.Controllers.changePasswordModalController"
      spacing="14.0" styleClass="modal-card">

    <padding>
        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
    </padding>

    <children>
        <Label text="Change Password" styleClass="modal-title" />

        <VBox spacing="8.0">
            <children>
                <Label text="Current password" />
                <PasswordField fx:id="currentPwField" promptText="Current password" />
            </children>
        </VBox>

        <VBox spacing="8.0">
            <children>
                <Label text="New password" />
                <PasswordField fx:id="newPwField" promptText="New password" />
            </children>
        </VBox>

        <VBox spacing="8.0">
            <children>
                <Label text="Confirm new password" />
                <PasswordField fx:id="confirmPwField" promptText="Confirm new password" />
            </children>
        </VBox>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="cancelBtn" text="Cancel" onAction="#onCancel" />
                <Button fx:id="saveBtn" text="Update" onAction="#onUpdate" />
            </children>
        </HBox>
    </children>
</VBox>
