<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="500.0" maxWidth="700.0" minHeight="500.0" minWidth="700.0" prefHeight="500.0" prefWidth="700.0" spacing="10.0" style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10;" stylesheets="@../CSS/managerSupervisorList.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.createLaborController">
   <children>
      <HBox>
         <children>
            <Label alignment="CENTER" prefHeight="0.0" prefWidth="175.0" style="-fx-text-fill: #000000;" text="Create New Labor" textFill="WHITE" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="8.0" />
         </VBox.margin>
      </HBox>

            <VBox prefHeight="486.0" prefWidth="620.0" spacing="15.0" VBox.vgrow="ALWAYS">
         <children>
            <Label style="-fx-text-fill: #000000;" text="Name" />
            <TextField fx:id="laborName" prefHeight="35.0" promptText="U Zaw Zaw" styleClass="input-field" VBox.vgrow="ALWAYS">
               <font>
                  <Font size="5.0" />
               </font></TextField>

                  <HBox VBox.vgrow="NEVER">
               <children>
                  <VBox prefHeight="67.0" prefWidth="401.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #000000;" text="Phone">
                           <VBox.margin>
                              <Insets bottom="6.0" />
                           </VBox.margin></Label>
                        <TextField fx:id="laborPhone" prefHeight="35.0" prefWidth="571.0" promptText="123456789" styleClass="input-field">
                           <font>
                              <Font size="5.0" />
                           </font></TextField>
                     </children>
                  </VBox>
                  <Region minWidth="10.0" prefHeight="63.0" prefWidth="10.0" HBox.hgrow="ALWAYS" />
                  <VBox prefWidth="255.0" spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #000000;" text="Experience Year" textFill="#666666">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="experienceYear" promptText="3" styleClass="input-field" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label style="-fx-text-fill: #000000;" text="Skill" textFill="#666666">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </Label>
                  <ComboBox fx:id="skillCombo" maxWidth="800.0" minWidth="600.0" prefHeight="48.0" prefWidth="781.0" promptText="Choose Skill" styleClass="input-field" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <HBox>
               <children>
                  <VBox prefHeight="67.0" prefWidth="420.0" HBox.hgrow="ALWAYS">
                     <children>
            
                                    <Label style="-fx-text-fill: #000000;" text="NRC" textFill="#666666">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="3.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="laborNRC" prefHeight="45.0" prefWidth="409.0" promptText="12/kakana/123456" styleClass="input-field">
                           <font>
                              <Font size="8.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  <Region minWidth="10.0" />
                  <VBox>
                     <children>
                        <Label style="-fx-text-fill: #000000;" text="Entrance Date">
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Label>
                        <HBox alignment="CENTER">
                           <children>
                              <DatePicker fx:id="startDatePicker" prefHeight="45.0" prefWidth="259.0" promptText="Start Date" style="-fx-border-color: #E18600; -fx-border-radius: 10; -fx-background-color: white;" styleClass="date-picker" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
      
                  <HBox alignment="TOP_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="handleCancel" mnemonicParsing="false" onAction="#clickHandleCancel" prefHeight="40.0" prefWidth="108.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-background-radius: 8;" styleClass="input-field" text="Cancel" />
                  <Button fx:id="addLaborBtn" mnemonicParsing="false" onAction="#clickAddLabor" prefHeight="40.0" prefWidth="113.0" styleClass="account-create-btn" text="ADD">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
   </padding>
</VBox>
