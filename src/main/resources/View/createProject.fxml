<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


  <VBox prefHeight="669.0" prefWidth="558.0" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.createProjectController">
      <children>

          <!-- header -->
          <HBox alignment="CENTER" prefHeight="26.0" prefWidth="485.0">
              <children>
                  <Label text="Creating Project" wrapText="true">
                      <font>
                  <Font size="20.0" />
               </font>
                  </Label>
            <Region HBox.hgrow="ALWAYS" />

                  <Button fx:id="closeBtn" alignment="TOP_LEFT" mnemonicParsing="false" onAction="#onClose" prefHeight="26.0" prefWidth="40.0" style="-fx-background-color: white;" textFill="GREY">
                      <HBox.margin>
                          <Insets />
                      </HBox.margin>
                      <font>
                  <Font size="17.0" />
               </font>
                  </Button>
              </children>

              <VBox.margin>
                  <Insets />
              </VBox.margin>
          </HBox>

          <!-- body -->
          <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="596.0" prefWidth="412.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="ALWAYS">
              <content>
                  <VBox prefHeight="706.0" prefWidth="459.0" spacing="5.0">

                      <children>

                          <!-- General Info -->
                          <TitledPane animated="false" prefHeight="443.0" prefWidth="443.0" style="-fx-background-color: white; -fx-border-color: 10;" text="General Info" VBox.vgrow="ALWAYS">
                              <font>
                        <Font name="System Bold Italic" size="17.0" />
                     </font>

                              <content>
                                  <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: white;">
                                      <children>

                                          <HBox alignment="CENTER" prefHeight="55.0" prefWidth="0.0" spacing="20.0">
                                              <children>
                                    <StackPane>
                                       <children>
                                                          <TextField fx:id="instanceNameTxt" minHeight="30.0" prefWidth="300.0" />
                                                          <Label fx:id="instanceNameLbl" text="Instance Name" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                    <StackPane>
                                       <children>
                                                          <!-- better as ComboBox because you already have supervisors/users -->
                                                          <ComboBox fx:id="siteEngineerBox" minHeight="30.0" prefWidth="300.0" StackPane.alignment="CENTER" />
                                                          <Label text="Site Engineer Name" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>

                                              </children>
                                              <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                                          </HBox>

                                          <HBox alignment="CENTER" prefHeight="55.0" prefWidth="484.0" spacing="20.0">
                                              <children>
                                    <StackPane>
                                       <children>
                                                          <ComboBox fx:id="projectTypeBox" minHeight="30.0" prefWidth="300.0" />
                                                          <Label text="Project Type" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                    <StackPane>
                                       <children>
                                                          <ComboBox fx:id="levelBox" minHeight="30.0" prefWidth="300.0" />
                                                          <Label text="Finishing Level" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>

                                              </children>
                                              <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                                          </HBox>

                                          <!-- building (your createViewProject uses building) -->
                                          <HBox alignment="CENTER" prefHeight="55.0" prefWidth="484.0" spacing="20.0">
                                              <children>
                                    <StackPane>
                                       <children>
                                                          <ComboBox fx:id="buildingBox" minHeight="30.0" prefWidth="300.0" />
                                                          <Label text="Building" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                    <StackPane>
                                       <children>
                                                          <TextField fx:id="contractValueTxt" minHeight="30.0" prefWidth="300.0" />
                                                          <Label fx:id="contractValueLbl" text="Contract Value" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                              </children>
                                              <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                                          </HBox>
                              <StackPane>
                                 <children>
                                                    <TextField fx:id="addressTxt" prefHeight="72.0" StackPane.alignment="CENTER" />
                                                    <Label fx:id="addressLbl" text="Address" StackPane.alignment="TOP_LEFT">
                                       <StackPane.margin>
                                          <Insets left="15.0" top="5.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>

                                      </children>
                                  </VBox>
                              </content>
                          </TitledPane>

                          <!-- Scheduling -->
                          <TitledPane animated="false" prefHeight="183.0" prefWidth="443.0" style="-fx-background-color: white; -fx-border-color: 10;" text="Scheduling" VBox.vgrow="ALWAYS">
                              <font>
                        <Font name="System Bold Italic" size="17.0" />
                     </font>

                              <content>
                                  <VBox alignment="TOP_CENTER" prefHeight="301.0" prefWidth="441.0" spacing="15.0" style="-fx-background-color: white;">
                                      <children>

                                          <HBox alignment="CENTER" prefHeight="55.0" prefWidth="431.0" spacing="20.0">
                                              <children>
                                    <StackPane>
                                       <children>
                                                          <DatePicker fx:id="startDatePicker" minHeight="30.0" prefWidth="300.0" />
                                                          <Label text="Planned Start Date" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                    <StackPane>
                                       <children>
                                                          <DatePicker fx:id="endDatePicker" minHeight="30.0" prefWidth="300.0" />
                                                          <Label text="Planned End Date" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                              </children>
                                              <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                                          </HBox>

                                          <HBox alignment="CENTER" spacing="20.0">
                                              <children>
                                    <StackPane>
                                       <children>
                                          <TextField fx:id="durationTxt" minHeight="30.0" prefWidth="300.0" StackPane.alignment="CENTER" />
                                          <Label fx:id="durationLbl" text="Duration" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>

                                    <StackPane>
                                       <children>
                                          <ComboBox fx:id="durationUnitCombo" minHeight="30.0" prefWidth="300.0" StackPane.alignment="CENTER" />
                                          <Label text="Duration Unit" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets bottom="45.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                              </children>
                                              <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                                          </HBox>

                                      </children>
                                  </VBox>
                              </content>

                              <VBox.margin>
                        <Insets />
                     </VBox.margin>
                          </TitledPane>

                          <!-- footer buttons -->
                          <HBox alignment="CENTER" prefHeight="50.0" prefWidth="425.0">
                              <children>
                                  <Button fx:id="denyBtn" mnemonicParsing="false" onAction="#onDeny" prefWidth="100.0" text="Deny" />

                                  <Button fx:id="approveBtn" mnemonicParsing="false" onAction="#onApprove" prefHeight="26.0" prefWidth="100.0" text="Approve">
                                      <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin>
                                  </Button>
                              </children>
                              <VBox.margin>
                        <Insets left="270.0" top="20.0" />
                     </VBox.margin>
                          </HBox>

                      </children>
                  </VBox>
              </content>

              <VBox.margin>
            <Insets />
         </VBox.margin>
          </ScrollPane>

      </children>
  </VBox>
