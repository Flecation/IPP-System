<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="669.0" prefWidth="558.0" spacing="5.0" styleClass="cp-root" stylesheets="@../CSS/createProject.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.createProjectController">
    <children>

        <!-- header -->
        <HBox alignment="CENTER" prefHeight="26.0" prefWidth="485.0" styleClass="cp-header">
            <children>
                <Label styleClass="cp-title" text="Creating Project" wrapText="true">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="closeBtn" alignment="CENTER" mnemonicParsing="false" onAction="#onClose" prefHeight="26.0" prefWidth="40.0" style="-fx-background-color: transparent; -fx-border-color: none;" text="✕">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                    <font>
                        <Font size="17.0" />
                    </font>
                </Button>
            </children>

            <VBox.margin>
                <Insets />
            </VBox.margin>
        </HBox>

        <!-- body -->
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="596.0" prefWidth="412.0" styleClass="cp-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox prefHeight="706.0" prefWidth="459.0">

                    <children>

                        <!-- General Info -->
                        <TitledPane animated="false" prefHeight="443.0" prefWidth="443.0" style="-fx-background-color: white; -fx-border-color: 10;" styleClass="cp-titled" text="General Info" VBox.vgrow="ALWAYS">
                            <font>
                                <Font name="System Bold Italic" size="17.0" />
                            </font>

                            <content>
                                <VBox alignment="TOP_CENTER" style="-fx-background-color: white;">
                                    <children>

                                        <HBox alignment="CENTER" minHeight="80.0" prefWidth="513.0" spacing="20.0">
                                            <children>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <TextField fx:id="instanceNameTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" />
                                                        <Label fx:id="instanceNameLbl" text="Instance Name" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets left="15.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <!-- better as ComboBox because you already have supervisors/users -->
                                                        <ComboBox fx:id="siteEngineerBox" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                                        <Label text="Site Engineer Name" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets bottom="50.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>

                                            </children>
                                            <VBox.margin>
                                                <Insets />
                                            </VBox.margin>
                                        </HBox>

                                        <HBox alignment="CENTER" minHeight="80.0" prefWidth="484.0" spacing="20.0">
                                            <children>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <ComboBox fx:id="projectTypeBox" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                                        <Label text="Project Type" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets bottom="50.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <ComboBox fx:id="levelBox" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                                        <Label text="Finishing Level" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets bottom="50.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>

                                            </children>
                                            <VBox.margin>
                                                <Insets />
                                            </VBox.margin>
                                        </HBox>

                                        <!-- building (your createViewProject uses building) -->
                                        <HBox alignment="CENTER" minHeight="80.0" prefWidth="484.0" spacing="20.0">
                                            <children>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <ComboBox fx:id="buildingBox" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                                        <Label text="Building" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets bottom="50.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <TextField fx:id="contractValueTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" />
                                                        <Label fx:id="contractValueLbl" text="Contract Value MMK" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets left="15.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                            </children>
                                            <VBox.margin>
                                                <Insets />
                                            </VBox.margin>
                                        </HBox>
                              <HBox alignment="CENTER" minHeight="80.0" spacing="20.0">
                                 <children>
                                    <StackPane maxHeight="50.0" minHeight="50.0">
                                       <children>
                                          <TextField fx:id="storyTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" />
                                          <Label fx:id="storyLbl" text="Total Stores" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                    <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <TextField fx:id="unitTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                          <Label fx:id="unitLbl" text="Total Units" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER" minHeight="80.0" spacing="20.0">
                                 <children>
                                    <StackPane maxHeight="50.0" minHeight="50.0">
                                       <children>
                                          <TextField fx:id="areaTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" />
                                          <Label fx:id="areaLbl" text="Area (ft sq)" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                    <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <TextField fx:id="heightTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                          <Label fx:id="heightLbl" text="Height (ft)" StackPane.alignment="CENTER_LEFT">
                                             <StackPane.margin>
                                                <Insets left="15.0" />
                                             </StackPane.margin>
                                          </Label>
                                       </children>
                                    </StackPane>
                                 </children>
                              </HBox>
                                        <StackPane minHeight="50.0" prefHeight="55.0">
                                            <children>
                                                <TextField fx:id="addressTxt" minHeight="70.0" prefHeight="72.0" styleClass="cp-input cp-address" StackPane.alignment="CENTER" />
                                                <Label fx:id="addressLbl" text="Address" StackPane.alignment="TOP_LEFT">
                                                    <StackPane.margin>
                                                        <Insets left="15.0" top="5.0" />
                                                    </StackPane.margin>
                                                </Label>
                                            </children>
                                        </StackPane>

                                    </children>
                                </VBox>
                            </content>
                        </TitledPane>

                        <!-- Scheduling -->
                        <TitledPane animated="false" prefHeight="183.0" prefWidth="443.0" style="-fx-background-color: white; -fx-border-color: 10;" styleClass="cp-titled" text="Scheduling" VBox.vgrow="ALWAYS">
                            <font>
                                <Font name="System Bold Italic" size="17.0" />
                            </font>

                            <content>
                                <VBox alignment="TOP_CENTER" prefHeight="301.0" prefWidth="441.0" style="-fx-background-color: white;">
                                    <children>

                                        <HBox alignment="CENTER" minHeight="80.0" spacing="20.0">
                                            <children>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <DatePicker fx:id="startDatePicker" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" />
                                                        <Label text="Planned Start Date" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets bottom="50.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                                <StackPane minHeight="80.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <DatePicker fx:id="endDatePicker" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" />
                                                        <Label text="Planned End Date" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets bottom="50.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                            </children>
                                            <VBox.margin>
                                                <Insets />
                                            </VBox.margin>
                                        </HBox>

                                        <HBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                                            <children>
                                                <StackPane maxHeight="50.0" minHeight="50.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <TextField fx:id="durationTxt" maxHeight="30.0" minHeight="30.0" prefWidth="300.0" styleClass="cp-input" StackPane.alignment="CENTER" />
                                                        <Label fx:id="durationLbl" text="Duration (Day)" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets left="15.0" />
                                                            </StackPane.margin>
                                                        </Label>
                                                    </children>
                                                </StackPane>
                                            </children>
                                            <VBox.margin>
                                                <Insets />
                                            </VBox.margin>
                                        </HBox>

                                    </children>
                                </VBox>
                            </content>

                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </TitledPane>

                        <!-- footer buttons -->
                        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="425.0" spacing="10.0" styleClass="cp-footer">
                            <children>
                                <Button fx:id="denyBtn" mnemonicParsing="false" onAction="#onDeny" prefHeight="40.0" prefWidth="120.0" styleClass="cp-btn cp-btn-secondary" text="Reset" />

                                <Button fx:id="approveBtn" mnemonicParsing="false" onAction="#onApprove" prefHeight="40.0" prefWidth="120.0" styleClass="cp-btn cp-btn-primary" text="Approve">
                                    <HBox.margin>
                                        <Insets left="10.0" />
                                    </HBox.margin>
                                </Button>
                            </children>
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </HBox>

                    </children>
                </VBox>
            </content>

            <VBox.margin>
                <Insets />
            </VBox.margin>
        </ScrollPane>

    </children>
</VBox>
