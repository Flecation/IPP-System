<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="720.0" style="-fx-border-radius: 18; -fx-background-radius: 18; -fx-background-color: white;" stylesheets="@../CSS/managerSupervisorList.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.createSupervisorController">
   <children>
      <HBox alignment="CENTER_LEFT">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <children>
            <Label text="Create New Account" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="CENTER">
         <children>
            <VBox alignment="TOP_CENTER">
               <children>
                  <StackPane styleClass="imgBox" translateY="-15.0">
                     <children>
                        <Label alignment="CENTER" maxHeight="30.0" maxWidth="100.0" minHeight="30.0" minWidth="100.0" style="-fx-border-style: dotted; -fx-border-radius: 10; -fx-border-color: #558C8A;" text="Drag and Drop" textFill="#b9abab" StackPane.alignment="CENTER" />
                        <ImageView fx:id="profileImg" fitHeight="170.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" styleClass="imgBox" StackPane.alignment="CENTER" />
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </StackPane>
                  <HBox alignment="CENTER" prefHeight="35.0" prefWidth="181.0" styleClass="\\">
                     <children>
                        <Button fx:id="UploadPhotobtn" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="100.0" mnemonicParsing="false" onAction="#ClickPhoto" styleClass="account-create-btn" text="Upload Profile" textFill="WHITE" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <TextField fx:id="userName" maxHeight="45.0" minHeight="45.0" promptText="Name" styleClass="input-field" VBox.vgrow="NEVER" />
                  <HBox alignment="CENTER_LEFT" spacing="20.0" VBox.vgrow="NEVER">
                     <children>
                        <TextField fx:id="Email" maxHeight="45.0" minHeight="45.0" minWidth="240.0" promptText="Email" styleClass="input-field" HBox.hgrow="ALWAYS" />
                        <DatePicker fx:id="DOBPicker" maxHeight="45.0" maxWidth="200.0" minHeight="45.0" promptText="DD/MM/YY" styleClass="input-field" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <ComboBox fx:id="RoleCombo" maxHeight="45.0" maxWidth="200.0" minHeight="45.0" promptText="Role" styleClass="input-field" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="PhoneNO" maxHeight="45.0" minHeight="45.0" minWidth="240.0" promptText="Phone" styleClass="input-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <TextField fx:id="Password" maxHeight="45.0" minHeight="45.0" promptText="Password" styleClass="input-field" />
                  <TextArea fx:id="Address" minHeight="100.0" promptText="Address" styleClass="input-field" wrapText="true" VBox.vgrow="NEVER">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </TextArea>
                  <HBox alignment="CENTER_RIGHT">
                     <children>
                        <Button fx:id="Cancelbtn" mnemonicParsing="false" onAction="#ClickCancel" prefHeight="34.0" prefWidth="125.0" styleClass="input-field" text="Cancel" />
                        <Region minWidth="10.0" />
                        <Button fx:id="Createbtn" mnemonicParsing="false" onAction="#ClickCreate" prefHeight="47.0" prefWidth="123.0" styleClass="account-create-btn" text="Create" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
