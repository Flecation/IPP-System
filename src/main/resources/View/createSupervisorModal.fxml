<VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="650.0" prefWidth="900.0" style="-fx-border-radius: 18; -fx-background-radius: 18; -fx-background-color: white;" stylesheets="@../CSS/managerSupervisorList.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.createSupervisorController">
