<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.currentProjectDashboardController">
   <content>
      <VBox alignment="CENTER" prefHeight="700.0" prefWidth="1250.0" spacing="15.0" styleClass="root" stylesheets="@../CSS/main.css">
         <children>
            <HBox alignment="CENTER" prefHeight="50.0" spacing="15.0" styleClass="titlePane">
               <children>
                  <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label fx:id="projectName" styleClass="header-text" text="Central Office Tower" wrapText="true" HBox.hgrow="ALWAYS" />
                              <Label fx:id="lblProgressStatus" alignment="CENTER" prefHeight="22.0" prefWidth="85.0" text="Delay" wrapText="true" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox spacing="5.0" VBox.vgrow="ALWAYS">
                           <children>
                              <Label styleClass="secondTitle" text="Current Task -" />
                              <Label fx:id="lbCurrentTask" text="Substructure" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="showLbl" text="View Type" />
                        <ComboBox fx:id="comboProjectList" maxHeight="27.0" maxWidth="180.0" minHeight="27.0" minWidth="180.0" onAction="#clickProjectSelect" prefHeight="40.0" prefWidth="173.0" promptText="Project Overview" styleClass="filter-box" />
                     </children>
                  </VBox>
                  <VBox>
                     <children>
                        <Label styleClass="showLbl" text="Date" />
                        <Label fx:id="lbDate" alignment="CENTER" maxHeight="27.0" maxWidth="120.0" minHeight="27.0" minWidth="120.0" styleClass="dateTitleLbl" text="October 13, 2023" textFill="#34495e" wrapText="true">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
      
            <HBox alignment="CENTER" prefHeight="230.0" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="105.0" prefWidth="210.0" styleClass="cardPane" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="header-text" text="Days Remaining" textFill="#7f8c8d" wrapText="true" HBox.hgrow="ALWAYS">
                                             <font>
                                                <Font />
                                             </font>
                                          </Label>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="dayRemainIcon" wrapText="true" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lbDaysRemaining" text="30 Days" VBox.vgrow="ALWAYS">
                                       <font>
                                          <Font name="System Bold" size="24.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets />
                                       </VBox.margin>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </VBox>
                              <VBox prefHeight="105.0" prefWidth="210.0" styleClass="cardPane" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="header-text" text="Earned Value" textFill="#7f8c8d" wrapText="true" HBox.hgrow="ALWAYS" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="evIcon" wrapText="true" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lbEarnedValue" text="0" VBox.vgrow="ALWAYS">
                                       <font>
                                          <Font name="System Bold" size="24.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets />
                                       </VBox.margin>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="105.0" prefWidth="210.0" styleClass="cardPane" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER">
                                       <children>
                                          <Label styleClass="header-text" text="Total Man-hour" textFill="#7f8c8d" wrapText="true" HBox.hgrow="ALWAYS" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="manHourIcon" wrapText="true" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lbTotalManHour" text="0 Hours" VBox.vgrow="ALWAYS">
                                       <font>
                                          <Font name="System Bold" size="24.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets />
                                       </VBox.margin>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </VBox>
                              <VBox prefHeight="105.0" prefWidth="210.0" styleClass="cardPane" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER">
                                       <children>
                                          <Label styleClass="header-text" text="Actual Cost" textFill="#7f8c8d" wrapText="true" HBox.hgrow="ALWAYS" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="acIcon" wrapText="true" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lbActualCost" text="0" VBox.vgrow="ALWAYS">
                                       <font>
                                          <Font name="System Bold" size="24.0" />
                                       </font>
                                       <VBox.margin>
                                          <Insets />
                                       </VBox.margin>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
      
                  <VBox alignment="CENTER" minWidth="350.0" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="cardPane" HBox.hgrow="ALWAYS">
                     <children>
                        <StackPane VBox.vgrow="ALWAYS">
                           <children>
                              <Circle fill="transparent" radius="65.0" stroke="#f1f2f6" strokeWidth="12.0" StackPane.alignment="CENTER" />
                              <Circle fx:id="circleSPI" fill="transparent" radius="65.0" stroke="#f1c40f" strokeLineCap="ROUND" strokeWidth="12.0" StackPane.alignment="CENTER" />
                              <Label fx:id="lbSPIPercentage" style="-fx-font-weight: bold; -fx-font-size: 22;" text="0%" StackPane.alignment="CENTER">
                                 <StackPane.margin>
                                    <Insets bottom="25.0" />
                                 </StackPane.margin>
                              </Label>
                              <Label styleClass="info-text" text="SPI" textFill="#7f8c8d" StackPane.alignment="CENTER">
                                 <StackPane.margin>
                                    <Insets top="25.0" />
                                 </StackPane.margin>
                              </Label>
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label styleClass="info-text" text="SPI :" textFill="#7f8c8d" />
                                    <Label fx:id="lbSPIValue" style="-fx-font-weight: bold;" text="0.00" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label styleClass="info-text" text="Status:" textFill="#7f8c8d" />
                                    <Label fx:id="lbSPIStatus" style="-fx-font-weight: bold;" text="Pending" textFill="#e74c3c" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
      
                  <VBox alignment="CENTER" minWidth="350.0" prefHeight="220.0" prefWidth="300.0" spacing="10.0" styleClass="cardPane" HBox.hgrow="ALWAYS">
                     <children>
                        <StackPane VBox.vgrow="ALWAYS">
                           <children>
                              <Circle fill="transparent" radius="65.0" stroke="#f1f2f6" strokeWidth="12.0" StackPane.alignment="CENTER" />
                              <Circle fx:id="circleCPI" fill="transparent" radius="65.0" stroke="#2ecc71" strokeLineCap="ROUND" strokeWidth="12.0" StackPane.alignment="CENTER" />
                              <Label fx:id="lbCPIPercentages" style="-fx-font-weight: bold; -fx-font-size: 22;" text="0%" StackPane.alignment="CENTER">
                                 <StackPane.margin>
                                    <Insets bottom="25.0" />
                                 </StackPane.margin>
                              </Label>
                              <Label styleClass="info-text" text="CPI" textFill="#7f8c8d" StackPane.alignment="CENTER">
                                 <StackPane.margin>
                                    <Insets top="25.0" />
                                 </StackPane.margin>
                              </Label>
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label styleClass="info-text" text="CPI :" textFill="#7f8c8d" />
                                    <Label fx:id="lbCPIValue" style="-fx-font-weight: bold;" text="0.00" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label styleClass="info-text" text="Status:" textFill="#7f8c8d" />
                                    <Label fx:id="lbCPIStatus" style="-fx-font-weight: bold;" text="Pending" textFill="#2ecc71" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
      
            <HBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" styleClass="box" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox styleClass="boxTitle">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 16;" styleClass="header-text" text="Monthly Project Performance" textFill="#2c3e50" />
                           </children>
                        </HBox>
                        <LineChart fx:id="lcMonthlyProjectPerformance" animated="false" prefHeight="240.0" VBox.vgrow="ALWAYS">
                           <xAxis>
                              <CategoryAxis side="BOTTOM" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis side="LEFT" />
                           </yAxis>
                        </LineChart>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0" styleClass="box" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox styleClass="boxTitle">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 16;" styleClass="header-text" text="Weekly Resource Usage" textFill="#2c3e50" />
                           </children>
                        </HBox>
                        <AreaChart fx:id="acWeeklyResourceUsage" animated="false" prefHeight="240.0" VBox.vgrow="ALWAYS">
                           <xAxis>
                              <CategoryAxis side="BOTTOM" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis side="LEFT" />
                           </yAxis>
                        </AreaChart>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
