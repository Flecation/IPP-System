<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.laborViewController">
   <content>
      <VBox alignment="CENTER" prefHeight="645.0" prefWidth="1120.0" spacing="10.0" styleClass="root" stylesheets="@../CSS/main.css">
         <children>
            <HBox alignment="CENTER" prefHeight="27.0" prefWidth="1120.0" styleClass="titlePane" VBox.vgrow="NEVER">
               <children>
                  <Label minWidth="200.0" styleClass="title" text=" Labors List" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="25.0" />
                     </font>
                  </Label>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="addLaborBtn" mnemonicParsing="false" onAction="#clickAddLabor" prefHeight="20.0" styleClass="createBtn" text="+ New Labor" textFill="WHITE" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER" prefHeight="81.0" prefWidth="1080.0" VBox.vgrow="NEVER">
               <children>
                  <VBox alignment="CENTER_LEFT" minHeight="80.0" minWidth="250.0" prefHeight="50.0" styleClass="cardPane" HBox.hgrow="NEVER">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <ImageView fitHeight="16.0" fitWidth="17.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/totallabor.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="header-text" text="TOTAL LABORS">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label fx:id="totalLaborQty" styleClass="box-qty" text="130" textFill="#17a460" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="System Bold" size="25.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <Region prefHeight="100.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER_LEFT" minHeight="80.0" minWidth="250.0" prefHeight="50.0" styleClass="cardPane" HBox.hgrow="NEVER">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <ImageView fitHeight="15.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/newhire.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="header-text" text="NEW HIRE">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <HBox alignment="BASELINE_LEFT" spacing="5.0">
                           <children>
                              <Label fx:id="newHireQty" styleClass="box-qty-active" text="130" textFill="#17a460">
                                 <font>
                                    <Font name="System Bold" size="25.0" />
                                 </font>
                              </Label>
                              <Label styleClass="info-text" text="In this month">
                                 <font>
                                    <Font size="8.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <Region prefHeight="100.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER_LEFT" minHeight="80.0" minWidth="250.0" prefHeight="50.0" styleClass="cardPane" HBox.hgrow="NEVER">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <ImageView fitHeight="14.0" fitWidth="13.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/active.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="header-text" text="ACTIVE ">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label fx:id="activeLaborQty" styleClass="box-qty-active" text="130" textFill="#17a460" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="System Bold" size="25.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <Region prefHeight="100.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER_LEFT" minHeight="80.0" minWidth="250.0" prefHeight="50.0" styleClass="cardPane" HBox.hgrow="NEVER">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <ImageView fitHeight="17.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../icons/active.png" />
                                 </image>
                              </ImageView>
                              <Label styleClass="header-text" text="RESIGNED">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        <Label fx:id="resignedQty" styleClass="box-qty-resign" text="130" textFill="#a1220e" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="System Bold" size="25.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0" style="-fx-background-color: #eeeeee; -fx-border-radius: 10; -fx-background-radius: 10;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="5.0">
                     <children>
                        <Label minWidth="80.0" styleClass="header-text" text="Total Labors " HBox.hgrow="ALWAYS" />
                        <Region prefHeight="26.0" HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="showLbl" text="Skill List" />
                              <ComboBox fx:id="skillFilterCombo" maxHeight="27.0" maxWidth="180.0" minHeight="27.0" minWidth="180.0" prefWidth="173.0" promptText="Skill" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="showLbl" text="Labors Status" />
                              <ComboBox fx:id="statusFilterCombo" maxHeight="27.0" maxWidth="180.0" minHeight="27.0" minWidth="180.0" prefHeight="26.0" prefWidth="173.0" promptText="Status" />
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
                  <TableView fx:id="laborTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="nameCol" prefWidth="75.0" text="Name" />
                      <TableColumn fx:id="aProjectCol" prefWidth="75.0" text="Assign Project" />
                        <TableColumn fx:id="phoneCol" prefWidth="75.0" text="Phone" />
                        <TableColumn fx:id="nrcCol" prefWidth="75.0" text="NRC" />
                        <TableColumn fx:id="activeCol" prefWidth="75.0" text="Active Status" />
                        <TableColumn fx:id="sDateCol" prefWidth="75.0" text="Start Date" />
                        <TableColumn fx:id="eDateCol" prefWidth="75.0" text="End Date" />
                        <TableColumn fx:id="actionCol" prefWidth="75.0" text="Action" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </TableView>
                  <HBox fx:id="paginationBox" maxHeight="60.0" maxWidth="400.0" minHeight="60.0" minWidth="400.0" stylesheets="@../CSS/pagination.css" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
