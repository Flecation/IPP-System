<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:id="root" alignment="TOP_LEFT" maxHeight="535.0" maxWidth="900.0" minHeight="535.0" minWidth="900.0" prefHeight="535.0" prefWidth="900.0" styleClass="background" stylesheets="@../CSS/login.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.loginController">

   <!-- =========================
        TOP BAR (fixed sizing)
        ========================= -->
   <BorderPane prefHeight="46.0" prefWidth="900.0" styleClass="topBar">

      <left>
         <Label styleClass="appName" text="IPP SYSTEM" BorderPane.alignment="CENTER_LEFT">
            <BorderPane.margin>
               <Insets left="18.0" />
            </BorderPane.margin>
         </Label>
      </left>

      <right>
         <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER_RIGHT">
            <BorderPane.margin>
               <Insets />
            </BorderPane.margin>
            <children>
               <Button fx:id="minimizeBtn" maxHeight="25.0" maxWidth="25.0" minHeight="25.0" minWidth="25.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="25.0" />
               <Button fx:id="restoreBtn" maxHeight="25.0" maxWidth="25.0" minHeight="25.0" minWidth="25.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="25.0" />
               <Button fx:id="exitBtn" maxHeight="25.0" maxWidth="25.0" minHeight="25.0" minWidth="25.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="25.0" />
            </children>
         </HBox>
      </right>
   </BorderPane>

   <!-- =========================
        MAIN AREA
        ========================= -->
   <StackPane fx:id="overlayPane" prefHeight="489.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
      <children>

         <!-- optional: if your controller uses imageView, this keeps it available (can remain invisible) -->
         <ImageView fx:id="imageView" managed="false" visible="false" />

         <!-- readability overlay for text on the left; safe even if your background is bright -->
         <Pane styleClass="overlay" />

         <HBox alignment="CENTER_LEFT" prefHeight="489.0" prefWidth="900.0" spacing="20.0">

            <children>

               <!-- LEFT HERO (new, no fx:id needed) -->
               <VBox alignment="CENTER_LEFT" prefWidth="540.0" spacing="10.0" styleClass="leftHero">
                  <padding>
                     <Insets bottom="22.0" left="20.0" right="18.0" top="22.0" />
                  </padding>

                  <children>
                     <Text styleClass="heroOutline" text="INTEGRATED" />
                     <Text styleClass="heroBold" text="PROJECT PLANNING" />
                     <Label styleClass="heroSub" text="Plan • Track • Deliver projects with clarity" />

                     <HBox spacing="12.0" styleClass="chips">
                        <children>
                           <Label styleClass="chip" text="Scheduling" />
                           <Label styleClass="chip" text="Resources" />
                           <Label styleClass="chip" text="Reports" />
                        </children>
                     </HBox>
                  </children>
               </VBox>

               <!-- RIGHT AREA (your original multi-page card, unchanged fx:ids) -->
               <StackPane alignment="TOP_CENTER" maxHeight="400.0" maxWidth="320.0" minHeight="400.0" minWidth="320.0">
                  <children>

                     <VBox alignment="CENTER" styleClass="rightBlur" StackPane.alignment="CENTER" />

                     <!-- LOGIN -->
                     <VBox fx:id="loginBox" alignment="CENTER" maxHeight="400.0" maxWidth="320.0" minHeight="400.0" minWidth="320.0" prefHeight="515.0" prefWidth="320.0" styleClass="rightPane" visible="false">
                        <children>
                           <Label alignment="CENTER" contentDisplay="CENTER" styleClass="header-text" text="Sign in your Account" translateY="-20.0" />

                           <StackPane maxHeight="80.0" minHeight="80.0" prefHeight="150.0" prefWidth="200.0">
                              <children>
                                 <TextField fx:id="userEmailTxt" maxHeight="40.0" maxWidth="250.0" minHeight="40.0" minWidth="250.0" StackPane.alignment="CENTER" />
                                 <Label fx:id="userEmailLbl" styleClass="info-text" text="User Email" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin>
                                       <Insets left="50.0" />
                                    </StackPane.margin>
                                 </Label>
                                 <Label fx:id="emailWrongLbl" minWidth="250.0" text="Label" StackPane.alignment="BOTTOM_LEFT">
                                    <StackPane.margin>
                                       <Insets left="50.0" />
                                    </StackPane.margin>
                                 </Label>
                              </children>
                           </StackPane>

                           <StackPane maxHeight="80.0" minHeight="80.0">
                              <children>
                                 <TextField fx:id="showPasswordTxt" maxHeight="40.0" maxWidth="250.0" minHeight="40.0" minWidth="250.0" StackPane.alignment="CENTER" />
                                 <PasswordField fx:id="hidePasswordTxt" maxHeight="40.0" maxWidth="250.0" minHeight="40.0" minWidth="250.0" prefHeight="40.0" prefWidth="396.0" StackPane.alignment="CENTER" />
                                 <Label fx:id="passwordLbl" styleClass="info-text" text="Password" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin>
                                       <Insets left="50.0" />
                                    </StackPane.margin>
                                 </Label>
                                 <CheckBox fx:id="showPasswordCheckBox" alignment="TOP_LEFT" mnemonicParsing="false" styleClass="info-text" text="Show Password" translateY="18.0" StackPane.alignment="BOTTOM_LEFT">
                                    <StackPane.margin>
                                       <Insets left="50.0" />
                                    </StackPane.margin>
                                 </CheckBox>
                                 <Label fx:id="pwWrongLbl" minWidth="250.0" text="Label" StackPane.alignment="BOTTOM_LEFT">
                                    <StackPane.margin>
                                       <Insets left="50.0" />
                                    </StackPane.margin>
                                 </Label>
                              </children>
                              <VBox.margin>
                                 <Insets bottom="30.0" />
                              </VBox.margin>
                           </StackPane>

                           <Button fx:id="loginBtn" maxHeight="36.0" maxWidth="250.0" minHeight="36.0" minWidth="250.0" mnemonicParsing="false" text="Login" translateY="5.0" />

                           <!-- IMPORTANT: controller expects Button -->
                           <Button fx:id="forgetBtn" mnemonicParsing="false" prefHeight="25.0" prefWidth="143.0" text="forget password ?" translateY="10.0" />
                        </children>
                     </VBox>

                     <!-- OTP -->
                     <VBox fx:id="otpBox" alignment="CENTER" maxHeight="400.0" maxWidth="320.0" minHeight="400.0" minWidth="320.0" prefHeight="515.0" prefWidth="320.0" spacing="5.0" styleClass="rightPane" visible="false" StackPane.alignment="CENTER">
                        <padding>
                           <Insets top="10.0" />
                        </padding>
                        <children>
                           <Label styleClass="header-text" text="OTP Verification" />
                           <Label styleClass="info-text" text="One Time Password(OTP) has been sent">
                              <VBox.margin><Insets top="10.0" /></VBox.margin>
                           </Label>
                           <Label fx:id="otpEmail" styleClass="info-text" text="via Email to :" />
                           <Label fx:id="otpEmailName" styleClass="info-text" text="Label" wrapText="true" />
                           <Label text="Enter the OTP below to verify it">
                              <VBox.margin><Insets top="30.0" /></VBox.margin>
                           </Label>

                           <HBox alignment="CENTER" minHeight="70.0" prefWidth="200.0" spacing="10.0">
                              <children>
                                 <TextField fx:id="otp1" minHeight="50.0" minWidth="50.0" styleClass="otpInput" />
                                 <TextField fx:id="otp2" minHeight="50.0" minWidth="50.0" styleClass="otpInput" />
                                 <TextField fx:id="otp3" minHeight="50.0" minWidth="50.0" styleClass="otpInput" />
                                 <TextField fx:id="otp4" minHeight="50.0" minWidth="50.0" styleClass="otpInput" />
                                 <TextField fx:id="otp5" minHeight="50.0" minWidth="50.0" styleClass="otpInput" />
                                 <TextField fx:id="otp6" minHeight="50.0" minWidth="50.0" styleClass="otpInput" />
                              </children>
                           </HBox>

                           <Button fx:id="verifyOtpBtn" minHeight="36.0" minWidth="250.0" mnemonicParsing="false" text="Verify OTP">
                              <VBox.margin><Insets top="10.0" /></VBox.margin>
                           </Button>
                        </children>
                     </VBox>

                     <!-- FORGET PASSWORD -->
                     <VBox fx:id="forgetPwBox" alignment="CENTER" maxHeight="400.0" maxWidth="320.0" minHeight="400.0" minWidth="320.0" prefHeight="515.0" prefWidth="320.0" spacing="5.0" styleClass="rightPane" visible="false" StackPane.alignment="CENTER">
                        <padding>
                           <Insets right="10.0" />
                        </padding>
                        <children>
                           <Label alignment="CENTER" contentDisplay="CENTER" minWidth="272.0" prefHeight="27.0" prefWidth="272.0" styleClass="info-text" text="Forgot Password ?" />

                           <Label alignment="CENTER" minWidth="300.0" prefHeight="22.0" prefWidth="308.0" text="Please type your email to receive the confirmation">
                              <padding><Insets left="10.0" /></padding>
                           </Label>

                           <Label alignment="CENTER" minWidth="300.0" prefHeight="22.0" prefWidth="308.0" text="code to reset a new password.">
                              <padding><Insets left="10.0" /></padding>
                              <VBox.margin><Insets top="-10.0" /></VBox.margin>
                           </Label>

                           <StackPane maxHeight="80.0" minHeight="80.0" prefHeight="150.0" prefWidth="200.0">
                              <children>
                                 <TextField fx:id="forgetPwEmailTxt" maxHeight="40.0" maxWidth="300.0" minHeight="40.0" minWidth="300.0" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin><Insets left="10.0" /></StackPane.margin>
                                 </TextField>
                                 <Label fx:id="forgetPwEmailLbl" styleClass="info-text" text="User Email" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin><Insets left="30.0" /></StackPane.margin>
                                 </Label>
                              </children>
                           </StackPane>

                           <Button fx:id="sentResetCodeBtn" minHeight="36.0" minWidth="250.0" mnemonicParsing="false" text="Sent reset Code">
                              <VBox.margin><Insets top="15.0" /></VBox.margin>
                           </Button>

                           <HBox fx:id="backToLoginRow" alignment="CENTER" spacing="10.0">
                              <children>
                                 <Label styleClass="backTo" text="Back to" />
                                 <Label fx:id="backToLogin" text="Log in" />
                              </children>
                           </HBox>
                        </children>
                     </VBox>

                     <!-- CHANGE NEW PASSWORD -->
                     <VBox fx:id="changeNewPwBox" alignment="CENTER" maxHeight="400.0" maxWidth="320.0" minHeight="400.0" minWidth="320.0" prefHeight="515.0" prefWidth="320.0" spacing="10.0" styleClass="rightPane" visible="false" StackPane.alignment="CENTER">
                        <padding>
                           <Insets left="50.0" right="10.0" top="10.0" />
                        </padding>
                        <children>
                           <Label styleClass="loginTitle" text="Change Password" />

                           <StackPane maxHeight="80.0" minHeight="80.0">
                              <children>
                                 <TextField fx:id="showChangePwTxt" maxHeight="40.0" maxWidth="250.0" minHeight="40.0" minWidth="250.0" StackPane.alignment="CENTER" />
                                 <PasswordField fx:id="hideChangePwTxt" maxHeight="40.0" maxWidth="250.0" minHeight="40.0" minWidth="250.0" prefHeight="40.0" prefWidth="396.0" StackPane.alignment="CENTER" />
                                 <Label fx:id="showChangePwLbl" styleClass="info-text" text="New Password" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin><Insets left="60.0" /></StackPane.margin>
                                 </Label>
                                 <CheckBox fx:id="showChangePwChoiceBox" mnemonicParsing="false" styleClass="info-text" text="Show Password" translateY="15.0" StackPane.alignment="BOTTOM_LEFT">
                                    <StackPane.margin><Insets left="50.0" /></StackPane.margin>
                                 </CheckBox>
                              </children>
                           </StackPane>

                           <Button fx:id="changePwBtn" minHeight="36.0" minWidth="250.0" mnemonicParsing="false" text="Change Password">
                              <VBox.margin><Insets top="10.0" /></VBox.margin>
                           </Button>
                        </children>
                     </VBox>

                  </children>
               </StackPane>

            </children>
            <padding>
               <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
         </HBox>

         <!-- email open overlay (kept from original) -->
         <BorderPane fx:id="openWithEmail" visible="false" StackPane.alignment="CENTER">
            <center>
               <Label fx:id="openEmailAction" minHeight="50.0" minWidth="200.0" styleClass="header-text" text="Open Via Email Code" BorderPane.alignment="CENTER" />
            </center>
            <top>
               <Region maxHeight="200.0" minHeight="196.0" opacity="0.48" prefHeight="196.0" prefWidth="900.0" BorderPane.alignment="CENTER" />
            </top>
            <left>
               <Region minWidth="300.0" opacity="0.48" prefHeight="117.0" prefWidth="300.0" BorderPane.alignment="CENTER" />
            </left>
            <bottom>
               <Region maxHeight="250.0" minHeight="250.0" opacity="0.48" BorderPane.alignment="CENTER" />
            </bottom>
            <right>
               <Region maxWidth="300.0" minWidth="300.0" opacity="0.48" BorderPane.alignment="CENTER" />
            </right>
         </BorderPane>

         <!-- alertPane exists in controller -->
         <VBox fx:id="alertPane" managed="false" mouseTransparent="true" pickOnBounds="false" visible="true" StackPane.alignment="CENTER" />

      </children>
   </StackPane>

</VBox>
