<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../CSS/navigationPane.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.navigationPaneController">
   <children>
      <HBox maxHeight="35.0" minHeight="35.0" styleClass="tapBar" VBox.vgrow="NEVER">
         <children>
            <HBox fx:id="tapBar" maxWidth="1190.0" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets left="5.0" />
               </HBox.margin>
