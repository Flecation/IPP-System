<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<StackPane fx:id="rootStack" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.navigationPaneController">
   <children>
      <VBox fx:id="root" prefHeight="202.0" prefWidth="199.0" stylesheets="@../CSS/navigationPane.css">
         <children>
            <HBox maxHeight="35.0" styleClass="tapBar" VBox.vgrow="NEVER">
               <children>
                  <HBox fx:id="tapBar" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                     <children>
                        <Button fx:id="pageAddBtn" mnemonicParsing="false">
                           <HBox.margin>
                              <Insets left="2.0" top="3.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                  </HBox>
                  <Region minHeight="0.0" minWidth="0.0" HBox.hgrow="ALWAYS" />
                  <HBox alignment="TOP_RIGHT" HBox.hgrow="NEVER">
                     <children>
                        <Button fx:id="minimizeBtn" maxHeight="35.0" maxWidth="35.0" minHeight="35.0" minWidth="35.0" mnemonicParsing="false" HBox.hgrow="NEVER" />
                        <Button fx:id="restoreBtn" maxHeight="35.0" maxWidth="35.0" minHeight="35.0" minWidth="35.0" mnemonicParsing="false" HBox.hgrow="NEVER" />
                        <Button fx:id="exitBtn" maxHeight="35.0" maxWidth="35.0" minHeight="35.0" minWidth="35.0" mnemonicParsing="false" HBox.hgrow="NEVER" />
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets top="2.0" />
               </VBox.margin>
            </HBox>
            <StackPane fx:id="loadPane" VBox.vgrow="ALWAYS">
               <children>
                  <AnchorPane fx:id="modalLayer" style="-fx-background-color: rgba(0,0,0,0.3);" visible="false" StackPane.alignment="CENTER">
                     <children>
                        <StackPane fx:id="modelBox" pickOnBounds="false" prefHeight="164.0" prefWidth="199.0" />
                     </children>
                  </AnchorPane>
               </children>
            </StackPane>
         </children>
      </VBox>
   </children>
</StackPane>
