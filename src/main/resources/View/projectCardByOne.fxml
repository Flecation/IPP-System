<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="598.0" style="-fx-border-color: #7fb8b6; -fx-border-radius: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.projectCardController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="67.0" prefWidth="528.0">
         <children>
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="projectId" text="PRJ-001" wrapText="true">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="projectName" lineSpacing="30.0" text="Central Tower Building" wrapText="true">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                     <padding>
                        <Insets top="8.0" />
                     </padding>
                  </Label>
                  <Label fx:id="supervisorName" />
               </children>
            </VBox>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="projectStatus" minWidth="80.0" text="Active" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" minHeight="30.0" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Location :" wrapText="true">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="30.0" prefWidth="106.0" />
            <Label fx:id="projectLocation" prefHeight="20.0" prefWidth="108.0" text="Yangon" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <padding>
            <Insets left="100.0" right="40.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" minHeight="30.0" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Duration :" wrapText="true">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="30.0" prefWidth="101.0" />
            <Label fx:id="duration" text="24 Months" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <padding>
            <Insets left="100.0" right="20.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" minHeight="30.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <Label prefHeight="30.0" prefWidth="247.0" text="Project Type :" wrapText="true">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="39.0" prefWidth="161.0" />
            <Label fx:id="projectType" minWidth="300.0" text="Industrial Building" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" />
               </font>
               <padding>
                  <Insets left="30.0" />
               </padding>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <padding>
            <Insets left="100.0" right="20.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <VBox.margin>
            <Insets top="32.0" />
         </VBox.margin>
         <children>
            <Button fx:id="detailsBtn" mnemonicParsing="false" style="-fx-background-color: #7fb8b6; -fx-background-radius: 20;" text="View Detail" textFill="WHITE">
               <padding>
                  <Insets bottom="10.0" left="230.0" right="230.0" top="10.0" />
               </padding></Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
