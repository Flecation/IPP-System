<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="300.0" prefWidth="598.0" style="-fx-border-color: #7fb8b6; -fx-border-radius: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.projectCardController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="67.0" prefWidth="528.0">
         <children>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="projectId" text="PRJ-001" wrapText="true">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="projectName" lineSpacing="30.0" text="Central Tower Building" wrapText="true">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                     <padding>
                        <Insets top="8.0" />
                     </padding>
                  </Label>
                  <Label fx:id="projectType" text="Industrial Building" />
               </children>
            </VBox>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="projectStatus" minWidth="80.0" text="Active">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" minHeight="30.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Supervisor" wrapText="true">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Label fx:id="supervisorName" text="Hsu Myat Moe" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <padding>
            <Insets left="100.0" right="20.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" minHeight="30.0" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Duration :" wrapText="true">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Label fx:id="duration" text="24 Months" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <padding>
            <Insets left="100.0" right="20.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER_LEFT" minHeight="30.0" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Location :" wrapText="true">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="20.0" prefWidth="173.0" />
            <Label fx:id="projectLocation" text="Yangon" wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <padding>
            <Insets left="100.0" right="40.0" />
         </padding>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
         <children>
            <Button fx:id="detailsBtn" mnemonicParsing="false" text="Button" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
