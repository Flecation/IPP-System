                                          <PropertyValueFactory property="endDate" />
                                      </cellValueFactory>
                                  </TableColumn>
                              </columns>

                              <columnResizePolicy>
                                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                              </columnResizePolicy>
                          </TableView>
                      </children>
            <VBox.margin>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
                  </VBox>
        </VBox>
    </content>
</ScrollPane>
