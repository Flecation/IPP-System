            <Label fx:id="projectName" styleClass="sub-title" text="Sunrise Building">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Region prefHeight="34.0" prefWidth="57.0" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="27.0" prefWidth="273.0">
         <children>
            <Region prefHeight="37.0" prefWidth="0.0" />
            <Label fx:id="projectStatus" text="In Progress">
               <font>
                  <Font size="10.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
   <padding>
