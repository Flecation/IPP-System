<VBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="83.0" prefWidth="313.0" styleClass="projects-cards" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.reportProjectController">
