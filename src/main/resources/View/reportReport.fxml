            <Label fx:id="reportId" styleClass="header-text" text="#RP- 01">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="27.0" prefWidth="273.0">
         <children>
            <Label fx:id="projectName" styleClass="info-text" text="Sunrise Building">
