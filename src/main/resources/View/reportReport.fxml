<VBox alignment="CENTER_LEFT" minHeight="90.0" prefHeight="83.0" prefWidth="313.0" styleClass="projects-cards" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.reportReportController">
   <children>
      <HBox prefHeight="20.0" prefWidth="273.0">
