                  <Insets />
               </BorderPane.margin>
               <children>
                  <VBox fx:id="settingBar" alignment="TOP_CENTER" maxWidth="170.0" minWidth="170.0" nodeOrientation="LEFT_TO_RIGHT" visible="false" StackPane.alignment="CENTER">
