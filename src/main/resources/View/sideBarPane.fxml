                           </padding>
                        </Label>
                        <HBox fx:id="backBtn" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" minWidth="170.0" spacing="5.0" VBox.vgrow="NEVER">
                           <children>
                              <Label styleClass="icons" text="◀" />
                              <Label text="Back" />
                           </children>
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                        </HBox>
                        <HBox fx:id="profileViewBtn" alignment="CENTER" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" minWidth="170.0" spacing="5.0" VBox.vgrow="NEVER">
                           <children>
                              <Label fx:id="profileIcon" minWidth="20.0" styleClass="icons" />
                              <Label maxWidth="140.0" minWidth="130.0" text="Edit Profile ▸" />
                           </children>
                        </HBox>
                        <HBox fx:id="toggleBtn" alignment="CENTER" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" minWidth="170.0" spacing="5.0" VBox.vgrow="NEVER">
                           <children>
                              <StackPane fx:id="light" minWidth="20.0" HBox.hgrow="NEVER">
                                 <children>
                                    <Label fx:id="darkSymbolIcon" styleClass="icons" />
                                    <Label fx:id="lightSymbolIcon" styleClass="icons" />
                                 </children>
                              </StackPane>
                              <Label fx:id="toggleSymbolText" maxWidth="140.0" text="Light Mode" wrapText="true" />
                              <StackPane fx:id="settingTogglePane" maxHeight="25.0">
                                 <children>
                                    <ToggleButton fx:id="settingToggleBox" maxHeight="25.0" maxWidth="50.0" minHeight="25.0" minWidth="50.0" mnemonicParsing="false" StackPane.alignment="CENTER" />
                                    <Circle fx:id="settingToggleCircle" fill="DODGERBLUE" radius="10.0" stroke="TRANSPARENT" strokeType="INSIDE" translateX="-14.0" StackPane.alignment="CENTER" />
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                        <HBox fx:id="changePasswordBtn" alignment="CENTER" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" minWidth="170.0" spacing="5.0" VBox.vgrow="NEVER">
                           <children>
                              <Label fx:id="changePwIcon" minWidth="20.0" styleClass="icons" />
                              <Label maxWidth="140.0" minWidth="130.0" text="Change Password ▸" />
                           </children>
                        </HBox>
                        <Region minWidth="170.0" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                        <HBox fx:id="settingViewBtn" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Label fx:id="settingIcon" maxWidth="60.0" minWidth="50.0" styleClass="icons" wrapText="true" />
                              <Label minWidth="105.0" text="Setting" wrapText="true" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox fx:id="sideBar" alignment="CENTER_LEFT" maxWidth="170.0" minWidth="170.0" StackPane.alignment="CENTER">
