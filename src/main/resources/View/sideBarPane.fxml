                           <children>
                              <Label fx:id="logoutIcon" maxWidth="60.0" minWidth="50.0" />
                              <Label minWidth="105.0" text="Logout" wrapText="true" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
                  <VBox fx:id="iconSideBar" alignment="TOP_CENTER" maxWidth="60.0" minWidth="60.0" visible="false" StackPane.alignment="CENTER_LEFT">
                     <StackPane.margin>
                        <Insets />
                     </StackPane.margin>
                     <children>
                        <Label fx:id="showSideBtn" maxHeight="30.0" maxWidth="50.0" minHeight="30.0" minWidth="50.0">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <padding>
                              <Insets left="5.0" />
                           </padding>
                        </Label>
                        <Circle fx:id="imageBtn" fill="DODGERBLUE" radius="20.0" stroke="BLACK" strokeType="INSIDE">
                           <VBox.margin>
                              <Insets left="5.0" right="15.0" top="20.0" />
                           </VBox.margin>
                        </Circle>
                        <Region maxHeight="60.0" minHeight="30.0" VBox.vgrow="ALWAYS" />
                        <Label fx:id="dashboardIconBtn" alignment="CENTER" maxHeight="60.0" maxWidth="50.0" minHeight="60.0" minWidth="50.0" />
                        <Label fx:id="projectIconBtn" alignment="CENTER" maxHeight="60.0" maxWidth="50.0" minHeight="60.0" minWidth="50.0" />
                        <Label fx:id="userIconBtn" alignment="CENTER" maxHeight="60.0" maxWidth="50.0" minHeight="60.0" minWidth="50.0" />
                        <Label fx:id="reportIconBtn" alignment="CENTER" maxHeight="60.0" maxWidth="50.0" minHeight="60.0" minWidth="50.0" />
                        <Region maxWidth="50.0" VBox.vgrow="ALWAYS" />
                        <Label fx:id="logoutIconBtn" alignment="CENTER" maxHeight="60.0" maxWidth="50.0" minHeight="60.0" minWidth="50.0" visible="true">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
                  <VBox fx:id="iconSettingBar" alignment="TOP_CENTER" maxWidth="60.0" minWidth="60.0" visible="false" StackPane.alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="showSettingBtn" maxHeight="30.0" minHeight="30.0" minWidth="60.0">
                           <padding>
                              <Insets left="5.0" />
                           </padding>
                        </Label>
                        <Label fx:id="iconBackBtn" alignment="CENTER" maxHeight="60.0" minHeight="60.0" minWidth="60.0" />
