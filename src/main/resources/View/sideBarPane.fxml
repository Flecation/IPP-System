                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </HBox>
                  <StackPane styleClass="searchBox" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                     <children>
                        <HBox fx:id="searchViewBox" alignment="CENTER" maxHeight="35.0" maxWidth="260.0" minHeight="0.0" minWidth="0.0">
                           <children>
                              <TextField fx:id="searchTextField" maxHeight="35.0" maxWidth="200.0" minHeight="35.0" minWidth="200.0" />
                              <Label fx:id="searchClearBtn" alignment="CENTER" maxHeight="30.0" maxWidth="35.0" minHeight="30.0" minWidth="35.0" styleClass="icons" HBox.hgrow="NEVER" />
                              <Label fx:id="searchBtn" alignment="CENTER" maxHeight="30.0" maxWidth="35.0" minHeight="30.0" minWidth="35.0" styleClass="icons" HBox.hgrow="NEVER" />
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                        </HBox>
                     </children>
                  </StackPane>
                  <HBox alignment="CENTER" spacing="5.0">
