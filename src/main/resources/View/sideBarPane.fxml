<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.sideBarPaneController">
   <children>
      <HBox maxHeight="60.0" minHeight="60.0" style="-fx-background-color:red;" VBox.vgrow="NEVER">
         <children>
            <Button mnemonicParsing="false" text="Button" />
            <HBox prefHeight="100.0" prefWidth="200.0" />
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <TextField />
                  <Button mnemonicParsing="false" text="Button" />
               </children>
            </StackPane>
         </children></HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox maxWidth="160.0" minWidth="160.0" HBox.hgrow="NEVER">
               <children>
                  <Button mnemonicParsing="false" text="Button" />
                  <Button mnemonicParsing="false" text="Button" />
                  <Button mnemonicParsing="false" text="Button" />
                  <Button mnemonicParsing="false" text="Button" />
               </children></VBox>
            <StackPane prefHeight="150.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>
