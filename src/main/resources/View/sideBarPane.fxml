                           <children>
                              <Label fx:id="darkIcon" alignment="CENTER" maxHeight="60.0" minHeight="60.0" minWidth="60.0" StackPane.alignment="CENTER" />
                              <Label fx:id="lightIcon" alignment="CENTER" maxHeight="60.0" minHeight="60.0" minWidth="60.0" StackPane.alignment="CENTER" />
                           </children>
                        </StackPane>
                        <Label fx:id="changePasswordIconBtn" alignment="CENTER" maxHeight="60.0" minHeight="60.0" minWidth="60.0" />
                        <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                        <Label fx:id="settingIconBtn" alignment="CENTER" maxHeight="60.0" maxWidth="50.0" minHeight="60.0" minWidth="50.0">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>
                  <VBox fx:id="profileBox" alignment="TOP_CENTER" maxWidth="170.0" minWidth="170.0" spacing="30.0" visible="false" StackPane.alignment="CENTER_LEFT">
                     <children>
                        <VBox spacing="10.0" VBox.vgrow="NEVER">
                           <children>
                              <StackPane>
                                 <children>
                                    <ImageView fx:id="userImage" fitHeight="150.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                                    <Label fx:id="imageEditBtn" text="✎" translateX="-55.0" translateY="23.0" wrapText="true" StackPane.alignment="BOTTOM_RIGHT" />
                                 </children>
                              </StackPane>
                              <Label fx:id="userRoleLbl" text="Manager" wrapText="true">
                                 <VBox.margin>
                                    <Insets left="20.0" />
                                 </VBox.margin>
                              </Label>
                              <Label fx:id="userNameLbl" text="Mg Aung Kyaw Soe" wrapText="true">
                                 <VBox.margin>
                                    <Insets left="20.0" />
                                 </VBox.margin>
                              </Label>
                           </children>
                        </VBox>
                        <!-- ========== Edit Profile pane (default) ========== -->
                        <VBox fx:id="editProfilePane" spacing="10.0">
                           <children>
                              <VBox spacing="10.0">
                                 <children>
                                    <Label text="🎂 Date Of Birth" />
                                    <Label fx:id="userDobLbl" text="27-9-2005">
                                       <VBox.margin>
                                          <Insets left="20.0" />
                                       </VBox.margin>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets left="20.0" />
                                 </padding>
                              </VBox>
                              <StackPane>
                                 <children>
                                    <TextField fx:id="userEmailTxtField" />
                                    <Label fx:id="userEmailLbl" text="📧 Email" StackPane.alignment="CENTER_LEFT">
                                       <StackPane.margin>
                                          <Insets left="20.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>
                              <StackPane>
                                 <children>
                                    <TextField fx:id="userPhoneTxtField" StackPane.alignment="CENTER" />
                                    <Label fx:id="userPhoneLbl" text="📱 Phone" StackPane.alignment="CENTER_LEFT">
                                       <StackPane.margin>
                                          <Insets left="20.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>
                              <HBox spacing="20.0">
                                 <children>
                                    <Button fx:id="revertBtn" mnemonicParsing="false" text="Revert" />
                                    <Button fx:id="confirmBtn" mnemonicParsing="false" text="Confirm" />
                                 </children>
                                 <padding>
                                    <Insets left="20.0" />
                                 </padding>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- ========== Change Password pane (same style as profile edit) ========== -->
                        <VBox fx:id="changePasswordPane" managed="false" spacing="10.0" visible="false">
                           <children>
                              <Label text="🔒 Change Password" />

                              <StackPane>
                                 <children>
                                    <PasswordField fx:id="currentPasswordField" />
                                    <Label text="Current" StackPane.alignment="CENTER_LEFT">
                                       <StackPane.margin>
                                          <Insets left="20.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>

                              <StackPane>
                                 <children>
                                    <PasswordField fx:id="newPasswordField" />
                                    <Label text="New" StackPane.alignment="CENTER_LEFT">
                                       <StackPane.margin>
                                          <Insets left="20.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>

                              <StackPane>
                                 <children>
                                    <PasswordField fx:id="confirmPasswordField" />
                                    <Label text="Confirm" StackPane.alignment="CENTER_LEFT">
                                       <StackPane.margin>
                                          <Insets left="20.0" />
                                       </StackPane.margin>
                                    </Label>
                                 </children>
                              </StackPane>

                              <HBox spacing="20.0">
                                 <children>
                                    <Button fx:id="changePwCancelBtn" mnemonicParsing="false" text="Cancel" />
                                    <Button fx:id="changePwSaveBtn" mnemonicParsing="false" text="Save" />
                                 </children>
                                 <padding>
                                    <Insets left="20.0" />
                                 </padding>
                              </HBox>
                           </children>
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </left>
         <center>
            <StackPane fx:id="loadPane" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin></StackPane>
         </center>
      </BorderPane>
      <!-- ===== Notification dropdown ===== -->
      <VBox fx:id="notificationDropdown" managed="false" maxWidth="320.0" styleClass="noti-dropdown" visible="false" StackPane.alignment="TOP_RIGHT">
         <StackPane.margin>
            <Insets right="14.0" top="62.0" />
         </StackPane.margin>
         <children>
            <VBox fx:id="notificationList" spacing="8.0" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
      <StackPane fx:id="addNewPane" managed="false" pickOnBounds="true" visible="false">

         <!-- Full-screen click catcher + dim background -->
         <Region fx:id="overlayCatcher" styleClass="overlay-catcher" />

         <!-- Your centered add form -->
         <StackPane fx:id="addNew" maxHeight="580.0" maxWidth="720.0" />
      </StackPane>

   </children>
</StackPane>
