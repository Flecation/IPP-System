                        <Label fx:id="showIconSideBtn" alignment="CENTER_RIGHT" maxHeight="30.0" maxWidth="170.0" minHeight="30.0" />
                        <HBox fx:id="userInfoCard" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" spacing="5.0">
                           <children>
                              <Circle fx:id="imageCircle" fill="DODGERBLUE" radius="20.0" stroke="BLACK" strokeType="INSIDE" HBox.hgrow="ALWAYS">
                                 <HBox.margin>
                                    <Insets left="5.0" />
                                 </HBox.margin></Circle>
                              <VBox alignment="CENTER_LEFT" minWidth="118.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="roleViewText" text="Manager" wrapText="true" VBox.vgrow="ALWAYS" />
                                    <Label fx:id="nameViewText" text="Mg Aung Zaw Myo" wrapText="true" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </HBox>
                        <Region maxHeight="50.0" VBox.vgrow="ALWAYS" />
                        <HBox fx:id="dashboardViewBtn" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" VBox.vgrow="NEVER">
                           <children>
                              <Label fx:id="dashboardIcon" maxWidth="60.0" minWidth="50.0" styleClass="icons" wrapText="true" />
                              <Label minWidth="105.0" text="DashBoard View" wrapText="true" />
                           </children>
                        </HBox>
                        <HBox fx:id="projectViewBtn" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="NEVER">
                           <children>
                              <Label fx:id="projectIcon" maxWidth="60.0" minWidth="50.0" styleClass="icons" wrapText="true" />
                              <Label minWidth="105.0" text="Project View" wrapText="true" />
                           </children>
                        </HBox>
                        <HBox fx:id="userViewBtn" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="NEVER">
                           <children>
                              <Label fx:id="userIcon" maxWidth="60.0" minWidth="50.0" styleClass="icons" wrapText="true" />
                              <Label fx:id="userViewLbl" minWidth="105.0" text="Supervisors" wrapText="true" />
                           </children>
                        </HBox>
                        <HBox fx:id="reportViewBtn" alignment="CENTER_LEFT" maxHeight="60.0" maxWidth="170.0" minHeight="60.0" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="NEVER">
                           <children>
                              <Label fx:id="reportIcon" maxWidth="60.0" minWidth="50.0" styleClass="icons" wrapText="true" />
                              <Label minWidth="105.0" text="Report View" wrapText="true" />
                           </children>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
