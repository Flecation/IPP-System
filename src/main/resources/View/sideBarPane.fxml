                        <StackPane fx:id="togglePane" maxHeight="45.0" maxWidth="60.0" minHeight="45.0" minWidth="60.0" styleClass="toggleBox">
                           <children>
                              <ToggleButton fx:id="toggleBox" maxHeight="25.0" maxWidth="45.0" minHeight="25.0" minWidth="45.0" mnemonicParsing="false" StackPane.alignment="CENTER" />
                              <Circle fx:id="toggleCircle" fill="DODGERBLUE" radius="10.0" stroke="TRANSPARENT" strokeType="INSIDE" translateX="-10.0" StackPane.alignment="CENTER" />
                           </children>
                        </StackPane>
                        <StackPane fx:id="notificationWrap" maxHeight="35.0" maxWidth="35.0" minHeight="35.0" minWidth="35.0">
                           <children>
                              <Label fx:id="notificationBtn" alignment="CENTER" maxHeight="35.0" maxWidth="35.0" minHeight="35.0" minWidth="35.0" styleClass="icons" />
                              <Circle fx:id="notificationDot" fill="#ff3b30" radius="4.0" stroke="TRANSPARENT" StackPane.alignment="TOP_RIGHT">
                                 <StackPane.margin>
                                    <Insets right="6.0" top="6.0" />
                                 </StackPane.margin>
                              </Circle>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
         </top>
         <left>
            <StackPane fx:id="sideBarStackPane" maxWidth="170.0" minWidth="0.0" styleClass="sideBar" BorderPane.alignment="CENTER">
