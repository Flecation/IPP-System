<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox prefHeight="675.0" prefWidth="1220.0" spacing="10.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="IPPSystem.Controllers.viewProjectsController">
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0">
         <children>
                    <Label prefHeight="28.0" prefWidth="246.0" text="Project Activity">
                        <font>
                            <Font name="System Bold" size="22.0" />
                        </font>
                    </Label>
            <Region prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="addBtn" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" mnemonicParsing="false" style="-fx-background-color: orange;" text="+ Add Project" wrapText="true" />
         </children>
      </HBox>
            <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" spacing="10.0">
                <children>
                    <Button fx:id="allBtn" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" mnemonicParsing="false" style="-fx-background-color: black; -fx-background-radius: 10;" text="All" textFill="WHITE">
                        <HBox.margin>
                            <Insets />
                        </HBox.margin>
                    </Button>
                    <Button fx:id="activeBtn" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 10;" text="Active">
                        <HBox.margin>
                            <Insets />
                        </HBox.margin>
                        <font>
                            <Font name="System Bold" size="15.0" />
                        </font>
                        <effect>
                            <DropShadow color="#8080808f" />
                        </effect>
                    </Button>
                    <Button fx:id="completedBtn" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 10;" text="Completed">
                        <HBox.margin>
                            <Insets />
                        </HBox.margin>
                        <font>
                            <Font name="System Bold" size="15.0" />
                        </font>
                        <effect>
                            <DropShadow color="#8080808e" />
                        </effect>
                    </Button>
                    <Button fx:id="planningBtn" maxHeight="30.0" maxWidth="120.0" minHeight="30.0" minWidth="120.0" mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 10;" text="Planning">
                        <font>
                            <Font name="System Bold" size="15.0" />
                        </font>
                        <effect>
                            <DropShadow color="#8080808e" />
                        </effect>
                        <HBox.margin>
                            <Insets />
                        </HBox.margin>
                    </Button>
            <Region prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="projectTypeChoiceBox" maxHeight="30.0" maxWidth="220.0" minHeight="30.0" minWidth="220.0" />
            <ComboBox fx:id="supervisorChoiceBox" maxHeight="30.0" maxWidth="220.0" minHeight="30.0" minWidth="220.0" />
                </children>
            </HBox>
      <VBox fx:id="projectContainer" prefHeight="200.0" prefWidth="100.0" spacing="10.0" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
