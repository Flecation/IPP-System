<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT"
      prefHeight="675.0" prefWidth="1220.0"
      spacing="12.0"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="IPPSystem.Controllers.workItemDetailsController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <children>

        <!-- HEADER -->
        <HBox alignment="CENTER" prefHeight="40.0">
            <padding>
                <Insets left="10.0" right="10.0" />
            </padding>
            <children>
                <Label prefHeight="40.0" prefWidth="150.0" text="Substructure" textFill="NAVY">
                    <font>
                        <Font name="System Bold" size="21.0" />
                    </font>
                </Label>
                <Label prefHeight="40.0" prefWidth="140.0" text="-  On Track" textFill="GREEN">
                    <font>
                        <Font name="System Bold Italic" size="12.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="backToProjectDetails" mnemonicParsing="false" text="Back" />
            </children>
        </HBox>

        <!-- KPI ROW -->
        <HBox spacing="10.0">
            <VBox.margin>
                <Insets left="10.0" right="10.0" />
            </VBox.margin>

            <children>

                <!-- Actual Cost -->
                <VBox alignment="CENTER" prefHeight="135.0" prefWidth="280.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Label text="Actual Cost" textFill="#6b7a99">
                            <font><Font size="11.0" /></font>
                        </Label>

                        <Label fx:id="actualCostPercent" text="-" style="-fx-font-weight: bold; -fx-font-size: 18px;" />

                        <HBox maxWidth="235.0" minWidth="235.0">
                            <children>
                                <Label fx:id="actualCost" text="-" textFill="#6b7a99">
                                    <font><Font size="10.0" /></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="totalCost" text="-" textFill="#6b7a99">
                                    <font><Font size="10.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <ProgressBar fx:id="actualCostProgress"
                                     maxHeight="18.0" minHeight="18.0"
                                     maxWidth="235.0" minWidth="235.0"
                                     progress="0.0"
                                     style="-fx-accent: #a4c3f5; -fx-background-color: white;">
                            <effect>
                                <ColorAdjust brightness="-0.3" contrast="0.44" />
                            </effect>
                        </ProgressBar>
                    </children>
                </VBox>

                <!-- Earned Value -->
                <VBox alignment="CENTER" prefHeight="135.0" prefWidth="280.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Label text="Earned Value" textFill="#6b7a99">
                            <font><Font size="11.0" /></font>
                        </Label>

                        <Label fx:id="earnValuePercent" text="-" style="-fx-font-weight: bold; -fx-font-size: 18px;" />

                        <HBox maxWidth="235.0" minWidth="235.0">
                            <children>
                                <Label fx:id="usedEarnValue" text="-" textFill="#6b7a99">
                                    <font><Font size="10.0" /></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="totalEarnValue" text="-" textFill="#6b7a99">
                                    <font><Font size="10.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <ProgressBar fx:id="earnValueProgress"
                                     maxHeight="18.0" minHeight="18.0"
                                     maxWidth="235.0" minWidth="235.0"
                                     progress="0.0"
                                     style="-fx-accent: #a4c3f5; -fx-background-color: white;">
                            <effect>
                                <ColorAdjust brightness="-0.3" contrast="0.44" />
                            </effect>
                        </ProgressBar>
                    </children>
                </VBox>

                <!-- SPI -->
                <HBox prefHeight="135.0" prefWidth="280.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="115.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Status" textFill="#6b7a99">
                                    <font><Font size="11.0" /></font>
                                </Label>
                                <Label fx:id="spiStatusLbl" text="-" style="-fx-font-weight: bold;" wrapText="true" />
                            </children>
                        </VBox>

                        <StackPane HBox.hgrow="ALWAYS">
                            <children>
                                <Circle fill="#00000000" radius="48.0" stroke="#e6e9ef" strokeType="INSIDE" strokeWidth="10.0" />
                                <Circle fx:id="spiCircle" fill="#00000000" radius="48.0" stroke="#4176f2" strokeType="INSIDE" strokeWidth="10.0" />
                                <Label fx:id="spiCircleRate" text="-" style="-fx-font-weight: bold;" />
                                <Label text="SPI" textFill="#6b7a99">
                                    <StackPane.margin>
                                        <Insets top="18.0" />
                                    </StackPane.margin>
                                </Label>
                            </children>
                        </StackPane>
                    </children>
                </HBox>

                <!-- CPI -->
                <HBox prefHeight="135.0" prefWidth="280.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="115.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Status" textFill="#6b7a99">
                                    <font><Font size="11.0" /></font>
                                </Label>
                                <Label fx:id="cpiStatusLbl" text="-" style="-fx-font-weight: bold;" wrapText="true" />
                            </children>
                        </VBox>

                        <StackPane HBox.hgrow="ALWAYS">
                            <children>
                                <Circle fill="#00000000" radius="48.0" stroke="#e6e9ef" strokeType="INSIDE" strokeWidth="10.0" />
                                <Circle fx:id="cpiCircle" fill="#00000000" radius="48.0" stroke="#4176f2" strokeType="INSIDE" strokeWidth="10.0" />
                                <Label fx:id="cpiCircleRate" text="-" style="-fx-font-weight: bold;" />
                                <Label text="CPI" textFill="#6b7a99">
                                    <StackPane.margin>
                                        <Insets top="18.0" />
                                    </StackPane.margin>
                                </Label>
                            </children>
                        </StackPane>
                    </children>
                </HBox>

            </children>
        </HBox>

        <!-- INFO + SKILLS -->
        <HBox spacing="20.0">
            <VBox.margin>
                <Insets left="10.0" right="10.0" />
            </VBox.margin>

            <children>

                <!-- Work Item Info -->
                <VBox fx:id="viewOnlyWorkItemInfo"
                      minWidth="520.0" maxWidth="520.0"
                      spacing="18.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>

                    <children>
                        <Label text="Work Item Info"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2a44;" />

                        <HBox spacing="20.0">

                            <!-- Left column -->
                            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                <children>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Budget:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewBudget" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Planned Start:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewPlanStartDate" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Actual Start:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewActualStartDate" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Duration:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewDuration" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                </children>
                            </VBox>

                            <!-- Right column -->
                            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                <children>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Total Labors:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewTotalLabors" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Planned End:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewPlanEndDate" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Label text="Actual End:" style="-fx-text-fill:#6b7a99; -fx-font-size:13px;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="viewActualEndDate" text="-" style="-fx-font-weight:bold; -fx-font-size:13px;" />
                                        </children>
                                    </HBox>

                                </children>
                            </VBox>

                        </HBox>
                    </children>
                </VBox>

                <!-- Skill Details -->
                <VBox spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS">

                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>

                    <children>
                        <Label text="Skill Details"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2a44;" />

                        <TableView fx:id="viewSkillTable" prefHeight="220.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="viewSkillCol" text="Skill" />
                                <TableColumn fx:id="viewQtyCol" text="Quantity" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- TASK DETAILS -->
        <VBox spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 12;"
              VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>

            <children>
                <Label text="Task Details"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1f2a44;" />

                <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="taskNameCol" text="Name" />
                        <TableColumn fx:id="taskDurationCol" text="Duration" />
                        <TableColumn fx:id="taskPlanStartDateCol" text="Planned Start Date" />
                        <TableColumn fx:id="taskPlanEndDateCol" text="Planned End Date" />
                        <TableColumn fx:id="TaskStatusCol" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>
